<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CompareHub — Nigeria's No. 1 Price Comparison Marketplace</title>
  <link rel="icon" type="image/svg+xml" href="images/logos/favicon.svg">

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            work:  ['"Work Sans"', 'sans-serif'],
            inter: ['Inter',       'sans-serif'],
          },
          colors: {
            brand: {
              primary: 'var(--color-primary)',
              hover:   'var(--color-primary-hover)',
              dark:    'var(--color-dark)',
              body:    'var(--color-body)',
              subtle:  'var(--color-subtle)',
              muted:   'var(--color-muted)',
              border:  'var(--color-border)',
              surface: 'var(--color-surface)',
              light:   'var(--color-light)',
              success: 'var(--color-success)',
              danger:  'var(--color-danger)',
            },
          },
          borderRadius: {
            btn:    'var(--radius-btn)',
            card:   'var(--radius-card)',
            panel:  'var(--radius-panel)',
            drawer: 'var(--radius-drawer)',
            pill:   'var(--radius-pill)',
          },
          fontSize: {
            'label':      ['var(--text-label)',      { lineHeight: '1.5' }],
            'caption':    ['var(--text-caption)',    { lineHeight: '1.5' }],
            'body-sm':    ['var(--text-body-sm)',    { lineHeight: '1.5' }],
            'body':       ['var(--text-body)',       { lineHeight: '1.5' }],
            'body-md':    ['var(--text-body-md)',    { lineHeight: '1.5' }],
            'heading-sm': ['var(--text-heading-sm)', { lineHeight: '1.5' }],
            'heading':    ['var(--text-heading)',    { lineHeight: '1.5' }],
            'heading-lg': ['var(--text-heading-lg)', { lineHeight: '1.2' }],
            'hero':       ['var(--text-hero)',        { lineHeight: '1.1' }],
          },
          boxShadow: {
            card:      'var(--shadow-card)',
            'card-hover': 'var(--shadow-card-hover)',
            header:    'var(--shadow-header)',
            drawer:    'var(--shadow-drawer)',
            dropdown:  'var(--shadow-dropdown)',
          },
          spacing: {
            'section': 'var(--spacing-section)',
          },
        },
      },
    };
  </script>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Work+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <!-- Lucide Icons — pinned version for reliability -->
  <script src="https://unpkg.com/lucide@0.441.0/dist/umd/lucide.min.js"></script>

  <link rel="stylesheet" href="css/styles.css">
</head>
<body class="font-work bg-[#f9fafb]">

  <div id="app-header"></div>

  <!-- ===================================================
       HEADER — renders both Guest & Authenticated states
       Toggle is managed by app.js (isAuthenticated flag)
       =================================================== -->
  <!-- ===================================================
       MOBILE HEADER — fixed top bar (mobile only)
       =================================================== -->
  <div id="mobile-header" class="sm:hidden fixed top-0 left-0 right-0 z-50 bg-white" style="padding: 14px 16px 12px; box-shadow: 0 1px 8px rgba(0,0,0,0.07)">

    <!-- Row 1: Greeting (left) + Location Change button (right) -->
    <div class="flex items-center justify-between mb-1">
      <p class="font-work font-medium text-[14px] text-[#364153]">Good morning 👋</p>
      <button id="mobile-location-change" class="flex items-center gap-1.5 bg-[#f3f4f6] rounded-[20px] px-3 py-1.5 active:bg-[#e5e7eb] transition-colors">
        <i data-lucide="map-pin" class="w-3.5 h-3.5 text-[#155dfc] shrink-0"></i>
        <span class="font-work font-medium text-[12px] text-[#364153]">Change</span>
      </button>
    </div>

    <!-- Row 2: Delivering to location -->
    <p class="font-work font-bold text-[16px] text-[#181d25] mb-3">
      Delivering to <span id="mobile-location-name" class="text-[#155dfc]">Lagos</span>
    </p>

    <!-- Row 3: Search bar -->
    <div class="relative" id="mobile-search-wrap">
      <i data-lucide="search" class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-[#808793] z-10"></i>
      <input id="mobile-search-input" type="text" placeholder="Search products, brands…"
        class="w-full bg-[#f3f4f6] rounded-[14px] pl-10 pr-4 font-work text-[14px] text-[#364153] placeholder-[#808793] outline-none border-none" style="height:44px" autocomplete="off">
      <!-- Search dropdown -->
      <div id="mobile-search-dropdown" class="hidden absolute left-0 right-0 bg-white rounded-[14px] shadow-lg z-50 overflow-hidden" style="top:50px; box-shadow:0 8px 24px rgba(0,0,0,0.12)"></div>
    </div>

  </div>

  <!-- ===================================================
       DESKTOP HEADER — hidden on mobile
       =================================================== -->
  <header id="site-header" class="hidden sm:block fixed top-0 left-0 right-0 z-50 h-[70px] border-b border-white/[0.22]">
    <div class="h-full px-[120px] flex items-center justify-between max-w-[1512px] mx-auto relative">

      <!-- ---- Logo ---- -->
      <a href="index.html" class="flex items-center gap-2 shrink-0">
        <!-- logo-transparent shown on hero, logo-scrolled shown after scroll (swapped by JS) -->
        <img id="site-logo" src="images/logos/logo-white.svg" alt="CompareHub" class="h-8 w-auto">
      </a>

      <!-- ---- Desktop Navigation ---- -->
      <nav class="hidden lg:flex items-center justify-between" style="width:413px">

        <!-- Nav links -->
        <div class="flex items-center gap-8">
          <a href="how-it-works.html" class="nav-link font-work font-medium text-[14px]">How it works</a>
          <a href="events.html" class="nav-link font-work font-medium text-[14px]">Events</a>
        </div>

        <!-- Action buttons -->
        <div class="flex items-center gap-3">

          <!-- Compare cart button (shared by both states) -->
          <button id="open-compare-drawer" class="bg-[#155dfc] flex items-center gap-[5px] px-[11px] py-[9px] rounded-[14px] relative hover:bg-[#1447e6] transition-colors">
            <i data-lucide="shopping-bag" class="w-4 h-4 text-white"></i>
            <span class="font-work font-medium text-[14px] text-white">Compare</span>
            <span id="compare-badge" class="hidden absolute -top-1.5 -right-1.5 bg-red-500 text-white text-[9px] font-inter font-bold rounded-full w-[18px] h-[18px] flex items-center justify-center leading-none">0</span>
          </button>

          <!-- GUEST: Sign in -->
          <div id="guest-actions">
            <button onclick="window.authShow && window.authShow('login')" id="sign-in-btn" class="sign-in-btn border font-work font-medium text-[14px] tracking-[-0.15px] px-[13px] py-[7px] rounded-[14px] block">
              Sign in
            </button>
          </div>

          <!-- AUTHENTICATED: User avatar + dropdown -->
          <div id="auth-actions" class="hidden relative">
            <button id="user-menu-btn" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
              <div class="w-8 h-8 rounded-full bg-[#155dfc] flex items-center justify-center shrink-0">
                <span class="font-inter font-semibold text-[13px] text-white">AO</span>
              </div>
              <span class="font-work font-medium text-[14px] text-white">Adaeze</span>
              <i data-lucide="chevron-down" id="user-chevron" class="w-3 h-3 text-white" style="transition:transform 0.2s"></i>
            </button>

            <!-- Dropdown -->
            <div id="user-dropdown" class="hidden">
              <a href="dashboard.html">
                <i data-lucide="user" class="w-4 h-4"></i>
                My Profile
              </a>
              <a href="compare-history.html">
                <i data-lucide="git-compare" class="w-4 h-4"></i>
                My Comparisons
              </a>
              <a href="account-settings.html">
                <i data-lucide="settings" class="w-4 h-4"></i>
                Settings
              </a>
              <hr style="border-color:#e5e7eb;margin:4px 0">
              <button id="sign-out-btn" class="sign-out">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                Sign out
              </button>
            </div>
          </div>

        </div>
      </nav>

      <!-- ---- Mobile Hamburger ---- -->
      <button id="mobile-menu-btn" class="lg:hidden text-white p-2 -mr-2" aria-label="Toggle menu">
        <i data-lucide="menu" id="hamburger-icon" class="w-6 h-6"></i>
        <i data-lucide="x" id="close-icon" class="w-6 h-6 hidden"></i>
      </button>
    </div>

    <!-- ---- Mobile Menu ---- -->
    <div id="mobile-menu" class="hidden lg:hidden bg-[#181d25] border-t border-white/10">
      <div class="px-6 py-5 flex flex-col gap-4">
        <a href="how-it-works.html" class="font-work font-medium text-[15px] text-white py-1">How it works</a>
        <a href="events.html" class="font-work font-medium text-[15px] text-white py-1">Events</a>
        <hr class="border-white/10">
        <button id="mobile-compare-btn" class="bg-[#155dfc] text-white font-work font-medium text-[14px] px-4 py-3 rounded-[14px] text-center">
          Compare
        </button>
        <button onclick="window.authShow && window.authShow('login')" id="mobile-signin" class="border border-white text-white font-work font-medium text-[14px] px-4 py-3 rounded-[14px] text-center">
          Sign in
        </button>
      </div>
    </div>
  </header>


  <!-- ===================================================
       MOBILE HERO BANNER — shown only on mobile
       =================================================== -->
  <section class="sm:hidden px-4 pt-4">
    <div id="mobile-hero" class="relative overflow-hidden rounded-[16px]" style="background:linear-gradient(130deg,#155dfc 0%,#1244d4 60%,#0b3ac7 100%); height:148px">

      <!-- Decorative radial blobs -->
      <div class="absolute rounded-full pointer-events-none" style="width:180px;height:180px;right:-20px;top:-50px;background:radial-gradient(circle,rgba(255,255,255,0.18) 0%,rgba(255,255,255,0) 70%)"></div>
      <div class="absolute rounded-full pointer-events-none" style="width:100px;height:100px;left:35%;bottom:-20px;background:radial-gradient(circle,rgba(255,255,255,0.1) 0%,rgba(255,255,255,0) 70%)"></div>

      <!-- Content row -->
      <div class="relative flex items-stretch h-full">

        <!-- Left: text content -->
        <div class="flex flex-col justify-center gap-2.5 pl-5 pr-2" style="flex:1; max-width:210px">
          <h2 class="font-work font-bold text-white leading-[1.2]" style="font-size:20px">
            Find the Best Price.
            <span style="color:#ffd234">Every Time.</span>
          </h2>
          <button class="bg-white font-work font-semibold text-[#155dfc] text-[12px] rounded-[20px] self-start" style="padding:7px 18px">
            Get Started
          </button>
        </div>

        <!-- Right: woman with shopping bags — drop image at images/mobile-hero-woman.png -->
        <div class="absolute bottom-0 right-0 pointer-events-none" style="width:145px; height:148px">
          <img src="images/mobile-hero-woman.png" alt="" class="w-full h-full object-cover object-top"
            onerror="this.style.display='none'">
        </div>

      </div>

      <!-- Slider dots -->
      <div class="absolute bottom-2.5 left-5 flex items-center gap-1.5">
        <span class="block rounded-full bg-white" style="width:16px;height:4px"></span>
        <span class="block rounded-full" style="width:4px;height:4px;background:rgba(255,255,255,0.45)"></span>
        <span class="block rounded-full" style="width:4px;height:4px;background:rgba(255,255,255,0.45)"></span>
      </div>
    </div>
  </section>


  <!-- ===================================================
       MOBILE CATEGORY PILLS — right after hero, mobile only
       =================================================== -->
  <section class="sm:hidden px-4 pt-3 pb-1">
    <div id="mobile-category-tabs" class="flex items-center gap-2 overflow-x-auto pb-1" style="scrollbar-width:none;-ms-overflow-style:none">
      <a href="category.html#cat=all"         class="mobile-cat-tab flex-shrink-0 font-work font-semibold text-[13px] rounded-[20px] px-4 py-2 text-white" style="background:var(--color-primary)">All</a>
      <a href="category.html#cat=phones"      class="mobile-cat-tab flex-shrink-0 font-work font-medium text-[13px] rounded-[20px] px-4 py-2 bg-white border border-[#e5e7eb] text-[#364153]">Phones</a>
      <a href="category.html#cat=gaming"      class="mobile-cat-tab flex-shrink-0 font-work font-medium text-[13px] rounded-[20px] px-4 py-2 bg-white border border-[#e5e7eb] text-[#364153]">Gaming</a>
      <a href="category.html#cat=electronics" class="mobile-cat-tab flex-shrink-0 font-work font-medium text-[13px] rounded-[20px] px-4 py-2 bg-white border border-[#e5e7eb] text-[#364153]">Cameras</a>
      <a href="category.html#cat=electronics" class="mobile-cat-tab flex-shrink-0 font-work font-medium text-[13px] rounded-[20px] px-4 py-2 bg-white border border-[#e5e7eb] text-[#364153]">Laptops</a>
      <a href="category.html#cat=food"        class="mobile-cat-tab flex-shrink-0 font-work font-medium text-[13px] rounded-[20px] px-4 py-2 bg-white border border-[#e5e7eb] text-[#364153]">Food</a>
    </div>
  </section>


  <!-- ===================================================
       HERO SLIDER — desktop only
       =================================================== -->
  <section id="hero" class="hidden sm:block relative overflow-hidden" style="height:680px">
    <div id="slider-track">

      <!-- Slide 1 — background only -->
      <div class="slide">
        <img src="images/sliders/Slider 1.png" alt="" class="absolute inset-0 w-full h-full object-cover">
      </div>

      <!-- Slide 2 — background only -->
      <div class="slide">
        <img src="images/sliders/Slider 2.png" alt="" class="absolute inset-0 w-full h-full object-cover">
      </div>

    </div><!-- /slider-track -->

    <!-- Static content overlay — does NOT slide -->
    <div class="absolute inset-x-0 bottom-0 flex flex-col items-center pb-[70px] z-10" style="top:45%">
      <div class="flex flex-col items-center gap-[30px] text-center" style="width:min(790px,100%);padding:0 24px">
        <div class="flex flex-col items-center gap-2" style="width:min(563px,100%)">
          <h1 class="font-work font-bold text-white text-center leading-tight" style="font-size:45px;width:min(401px,100%)">
            Find the Best Price.Every Time.
          </h1>
          <p class="font-work font-medium text-white/90 leading-[28px] tracking-[-0.44px]" style="font-size:18px;width:min(563px,100%)">
            CompareHub lets you search products and compare prices from multiple brands near you — so you always buy at the lowest price.
          </p>
        </div>
        <!-- Search bar -->
        <div class="bg-white/10 backdrop-blur-sm rounded-[30px] flex items-center gap-3 relative" style="height:66px;padding:15px 20px;width:min(760px,100%)">
          <div class="relative shrink-0" style="flex:1 1 313px;min-width:0">
            <input type="text" id="hero-search" placeholder="Search product name.."
              class="bg-[#f9fafb] w-full rounded-[14px] px-4 font-inter text-[#364153] placeholder-[#808793] outline-none border-none" style="height:32px;font-size:14px" autocomplete="off">
            <!-- Desktop search dropdown -->
            <div id="desktop-search-dropdown" class="hidden absolute left-0 right-0 bg-white rounded-[14px] shadow-lg z-50 overflow-hidden" style="top:40px; box-shadow:0 8px 24px rgba(0,0,0,0.14); min-width:320px"></div>
          </div>
          <div class="relative shrink-0" style="width:131px">
            <select id="brand-filter" class="bg-white rounded-[14px] pl-3 pr-8 font-work text-[#808793] outline-none cursor-pointer w-full" style="height:32px;font-size:14px">
              <option value="">By Brands</option>
              <option>Apple</option><option>Samsung</option><option>Sony</option>
              <option>JBL</option><option>Canon</option>
            </select>
            <i data-lucide="chevron-down" class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none w-3 h-3 text-[#808793]"></i>
          </div>
          <div class="relative shrink-0" style="width:131px">
            <select id="location-filter" class="bg-white rounded-[14px] pl-3 pr-8 font-work text-[#808793] outline-none cursor-pointer w-full" style="height:32px;font-size:14px">
              <option value="">By Location</option>
              <option>Abia</option><option>Adamawa</option><option>Akwa Ibom</option>
              <option>Anambra</option><option>Bauchi</option><option>Bayelsa</option>
              <option>Benue</option><option>Borno</option><option>Cross River</option>
              <option>Delta</option><option>Ebonyi</option><option>Edo</option>
              <option>Ekiti</option><option>Enugu</option><option>FCT — Abuja</option>
              <option>Gombe</option><option>Imo</option><option>Jigawa</option>
              <option>Kaduna</option><option>Kano</option><option>Katsina</option>
              <option>Kebbi</option><option>Kogi</option><option>Kwara</option>
              <option>Lagos</option><option>Nasarawa</option><option>Niger</option>
              <option>Ogun</option><option>Ondo</option><option>Osun</option>
              <option>Oyo</option><option>Plateau</option><option>Rivers</option>
              <option>Sokoto</option><option>Taraba</option><option>Yobe</option>
              <option>Zamfara</option>
            </select>
            <i data-lucide="chevron-down" class="absolute right-2.5 top-1/2 -translate-y-1/2 pointer-events-none w-3 h-3 text-[#808793]"></i>
          </div>
          <button id="hero-search-btn" class="bg-[#155dfc] rounded-[14px] font-work font-medium text-white hover:bg-[#1447e6] transition-colors shrink-0" style="width:141px;height:32px;font-size:12px">
            Show Result
          </button>
        </div>
      </div>
    </div>

    <!-- Slider Dots -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20" aria-label="Slide indicators">
      <button class="slider-dot active" data-slide="0" aria-label="Slide 1"></button>
      <button class="slider-dot" data-slide="1" style="width:6px;height:6px;background:rgba(255,255,255,0.4)" aria-label="Slide 2"></button>
    </div>


  </section>


  <!-- ===================================================
       MOBILE FLASH DEALS STRIP — mobile only (after categories)
       =================================================== -->
  <section class="sm:hidden px-4 pt-3">
    <div class="flash-deals-strip">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shrink-0">
          <span class="text-[16px] leading-none">⚡</span>
        </div>
        <div>
          <p class="font-work font-bold text-[14px] text-white leading-tight">Flash Deals</p>
          <p class="font-work text-[12px] leading-tight" style="color:rgba(255,255,255,0.75)">Best prices, time-limited</p>
        </div>
      </div>
      <a href="category.html#cat=all" class="bg-white font-work font-semibold text-[12px] text-[#155dfc] rounded-full px-4 py-2 flex items-center gap-1 shrink-0">
        Shop now
        <i data-lucide="chevron-right" class="w-3 h-3 text-[#155dfc]"></i>
      </a>
    </div>
  </section>


  <!-- ===================================================
       FEATURES BAR — desktop only
       =================================================== -->
  <section class="hidden sm:block bg-[#f9fafb] px-[111px] pt-8 pb-4">
    <div class="max-w-[1290px] mx-auto">
      <div class="features-bar bg-white rounded-[20px] px-10 py-5 flex flex-wrap items-center justify-between gap-6 shadow-sm">

        <!-- Free Shipping -->
        <div class="flex items-center gap-4 shrink-0">
          <div class="w-[35px] h-[35px] shrink-0 flex items-center justify-center bg-[#e5edff] rounded-full">
            <i data-lucide="truck" class="w-5 h-5 text-[#155dfc]"></i>
          </div>
          <div>
            <p class="font-work font-semibold text-[15px] text-[#364153] leading-normal">Free Shipping</p>
            <p class="font-work text-[14px] text-[#5a6372] leading-normal">On order over ₦50k+</p>
          </div>
        </div>

        <!-- Verified Nigerian -->
        <div class="flex items-center gap-4 shrink-0">
          <div class="w-[35px] h-[35px] shrink-0 flex items-center justify-center bg-[#e5edff] rounded-full">
            <i data-lucide="badge-check" class="w-5 h-5 text-[#155dfc]"></i>
          </div>
          <div>
            <p class="font-work font-semibold text-[15px] text-[#364153] leading-normal">Verified Nigerian</p>
            <p class="font-work text-[14px] text-[#5a6372] leading-normal">Vendors only</p>
          </div>
        </div>

        <!-- Compare Prices -->
        <div class="flex items-center gap-4 shrink-0">
          <div class="w-[35px] h-[35px] shrink-0 flex items-center justify-center bg-[#e5edff] rounded-full">
            <i data-lucide="bar-chart-2" class="w-5 h-5 text-[#155dfc]"></i>
          </div>
          <div>
            <p class="font-work font-semibold text-[15px] text-[#364153] leading-normal">Compare Prices</p>
            <p class="font-work text-[14px] text-[#5a6372] leading-normal">Save up to 40%</p>
          </div>
        </div>

        <!-- Secure Payment -->
        <div class="flex items-center gap-4 shrink-0">
          <div class="w-[35px] h-[35px] shrink-0 flex items-center justify-center bg-[#e5edff] rounded-full">
            <i data-lucide="shield-check" class="w-5 h-5 text-[#155dfc]"></i>
          </div>
          <div>
            <p class="font-work font-semibold text-[15px] text-[#364153] leading-normal">Secure Payment</p>
            <p class="font-work text-[14px] text-[#5a6372] leading-normal">100% Fast &amp; Secure Payment</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ===================================================
       MAIN CONTENT
       =================================================== -->
  <main class="main-container bg-[#f9fafb] px-[111px] pt-8 pb-16">
    <div class="max-w-[1290px] mx-auto space-y-12">

      <!-- ---- Browse Category — desktop only ---- -->
      <section class="hidden sm:block">
        <div class="flex flex-col items-center gap-3 mb-10">
          <h2 class="font-work font-semibold text-[18px] text-[#364153] text-center">Browse Category</h2>
          <div class="flex flex-wrap items-center justify-center gap-2" id="category-tabs">
            <a href="category.html#cat=all"         class="category-tab active-tab px-4 py-2 rounded-full border border-[#d1d5db] bg-white font-work font-medium text-[14px] text-[#364153] cursor-pointer">All</a>
            <a href="category.html#cat=electronics" class="category-tab px-4 py-2 rounded-full border border-[#d1d5db] bg-white font-work font-medium text-[14px] text-[#364153] cursor-pointer">Mobile Phones</a>
            <a href="category.html#cat=electronics" class="category-tab px-4 py-2 rounded-full border border-[#d1d5db] bg-white font-work font-medium text-[14px] text-[#364153] cursor-pointer">Laptop</a>
            <a href="category.html#cat=food"        class="category-tab px-4 py-2 rounded-full border border-[#d1d5db] bg-white font-work font-medium text-[14px] text-[#364153] cursor-pointer">Foods &amp; Drinks</a>
