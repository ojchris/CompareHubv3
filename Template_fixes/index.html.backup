    </button>

    <!-- Account -->
    <button class="mobile-nav-tab" data-tab="account">
      <i data-lucide="user" class="w-5 h-5" style="stroke:var(--color-muted)"></i>
      <span class="nav-label">Account</span>
    </button>

  </nav>


  <!-- ===================================================
       COMPARE DRAWER  (slides up from bottom)
       =================================================== -->
  <div id="compare-drawer" role="dialog" aria-label="Compare list">
    <div class="flex items-center justify-between mb-5">
      <div>
        <h3 class="font-work font-bold text-[18px] text-[#181d25]">Compare Products</h3>
        <p class="font-work text-[13px] text-[#5a6372] mt-0.5">Select up to 4 products to compare side-by-side</p>
      </div>
      <div class="flex items-center gap-3">
        <button id="compare-clear-btn" class="font-work font-medium text-[13px] text-[#5a6372] hover:text-red-500 transition-colors">
          Clear all
        </button>
        <button id="compare-now-btn" class="bg-[#155dfc] text-white font-work font-semibold text-[14px] px-6 py-2.5 rounded-[12px] hover:bg-[#1447e6] transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
          Compare Now
        </button>
        <button id="close-compare-drawer" class="text-[#5a6372] hover:text-[#181d25] transition-colors p-1">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>
    </div>
    <div id="compare-items-row" class="flex items-start gap-4">
      <!-- Compare item slots rendered by JS -->
    </div>
  </div>

  <!-- ===================================================
  <!-- Toast notification -->
  <div id="toast"></div>

  <div id="app-footer"></div>
  <div id="app-mobile-nav"></div>

  <script src="js/components.js"></script>
  <script src="js/app.js"></script>
</body>
</html>
