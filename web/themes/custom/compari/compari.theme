/**
 * Implements hook_form_alter() for views exposed forms.
 */
function compari_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Check if this is the discover search form
  if ($form['#id'] == 'views-exposed-form-discover-page-1' || $form['#id'] == 'views-exposed-form-discover-search') {
    
    // 1. Style the main form container — stacked on mobile, row on desktop
    $form['#attributes']['class'][] = 'bg-white/10 backdrop-blur-sm rounded-[30px] flex flex-col sm:flex-row items-center gap-3 relative h-auto sm:h-[66px] p-4 sm:p-0 sm:px-5 w-full sm:w-[min(760px,100%)]';

    // 2. Define the input styling
    $base_input_classes = 'bg-[#f9fafb] rounded-[14px] px-4 font-work text-[#808793] outline-none border-none cursor-pointer text-[14px] h-[44px] sm:h-[32px] w-full';

    // 3. Apply styles and placeholders to each field
    $fields = [
      'product_name' => [
        'placeholder' => 'Search product name..',
        'width' => 'w-full sm:flex-[1_1_313px]',
      ],
      'product_category' => [
        'placeholder' => 'By Category...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'product_source' => [
        'placeholder' => 'By Brand...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'brand_location' => [
        'placeholder' => 'By Location...',
        'width' => 'w-full sm:w-[131px]',
      ],
    ];

     foreach ($fields as $field_name => $config) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#attributes']['class'][] = $base_input_classes;
        $form[$field_name]['#attributes']['placeholder'] = t($config['placeholder']);
        $form[$field_name]['#wrapper_attributes']['class'][] = 'm-0 ' . $config['width'];
      }
    }

    // 4. Style the Submit button — full width tap target on mobile, fixed width on desktop
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['class'][] = 'bg-[#155dfc] rounded-[14px] font-work font-medium text-white hover:bg-[#1447e6] transition-colors shrink-0 w-full sm:w-[141px] h-[44px] sm:h-[32px] text-[14px] sm:text-[12px]';
      $form['actions']['#attributes']['class'][] = 'w-full sm:w-auto';
    }
  }
}
