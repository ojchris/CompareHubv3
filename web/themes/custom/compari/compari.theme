<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the compari theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function compari_preprocess_html(array &$variables): void {

}


/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function compari_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\Entity\Node $node */
  $node = $variables['node'];

  // Only run for Brand nodes on the full view mode.
  if ($node->bundle() === 'brand' && $variables['view_mode'] === 'full') {
    $variables['store_products'] = NULL;
    $variables['store_product_count'] = 0;

    // Check if the Brand has a store referenced.
    if ($node->hasField('field_store') && !$node->get('field_store')->isEmpty()) {
      $store_id = (int) $node->get('field_store')->target_id;

      // Run the homepage_products view, overriding filters at runtime.
      $view = \Drupal\views\Views::getView('homepage_products');
      if ($view) {
        $view->setDisplay('default');

        // Remove the category filter so we see all products for this store.
        $view->removeHandler('default', 'filter', 'field_category_target_id');
        
        // Add a runtime filter on the stores entity reference field.
        $view->addHandler('default', 'filter', 'commerce_product__stores', 'stores_target_id', [
          'id'       => 'stores_target_id',
          'table'    => 'commerce_product__stores',
          'field'    => 'stores_target_id',
          'value'    => ['value' => $store_id],
          'operator' => '=',
          'group'    => 1,
          'exposed'  => FALSE,
        ]);

        $view->execute();

        $variables['store_products'] = $view->render();
        $variables['store_product_count'] = count($view->result);
      }
    }
  }
}

/**
 * Implements hook_form_alter() for views exposed forms.
 */
function compari_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Check if this is the discover search form
  if ($form['#id'] == 'views-exposed-form-discover-page-1' || $form['#id'] == 'views-exposed-form-discover-search') {
    
    // 1. Style the main form container — stacked on mobile, row on desktop
    $form['#attributes']['class'][] = 'bg-white/10 backdrop-blur-sm rounded-[30px] flex flex-col sm:flex-row items-center gap-3 relative h-auto sm:h-[66px] p-4 sm:p-0 sm:px-5 w-full sm:w-[min(760px,100%)]';

    // 2. Define the input styling
    $base_input_classes = 'bg-[#f9fafb] rounded-[14px] px-4 font-work text-[#808793] outline-none border-none cursor-pointer text-[14px] h-[44px] sm:h-[32px] w-full';

    // 3. Apply styles and placeholders to each field
    $fields = [
      'product_name' => [
        'placeholder' => 'Search product name..',
        'width' => 'w-full sm:flex-[1_1_313px]',
      ],
      'product_category' => [
        'placeholder' => 'By Category...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'product_source' => [
        'placeholder' => 'By Brand...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'brand_location' => [
        'placeholder' => 'By Location...',
        'width' => 'w-full sm:w-[131px]',
      ],
    ];

     foreach ($fields as $field_name => $config) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#attributes']['class'][] = $base_input_classes;
        $form[$field_name]['#attributes']['placeholder'] = t($config['placeholder']);
        $form[$field_name]['#wrapper_attributes']['class'][] = 'm-0 ' . $config['width'];
      }
    }

    // 4. Style the Submit button — full width tap target on mobile, fixed width on desktop
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['class'][] = 'bg-[#155dfc] rounded-[14px] font-work font-medium text-white hover:bg-[#1447e6] transition-colors shrink-0 w-full sm:w-[141px] h-[44px] sm:h-[32px] text-[14px] sm:text-[12px]';
      $form['actions']['#attributes']['class'][] = 'w-full sm:w-auto';
    }
  }
}

/**
 * Implements hook_preprocess_page().
 * Passes the current user's display name and first name to all page templates.
 */
function compari_preprocess_page(array &$variables): void {
  $account = \Drupal::currentUser();
  if ($account->isAuthenticated()) {
    $name = $account->getDisplayName();
    $variables['current_user_name'] = $name;
    // First name only (everything before the first space)
    $parts = explode(' ', $name);
    $variables['current_user_first_name'] = $parts[0];
    // Two-letter initials: first char of first + last word
    $first = mb_substr($parts[0], 0, 1);
    $last  = count($parts) > 1 ? mb_substr(end($parts), 0, 1) : '';
    $variables['current_user_initials'] = mb_strtoupper($first . $last);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function compari_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // If the login form is rendered inside the modal on another page, force it to POST
  // to /user/login. This ensures that on a wrong password, the user is taken to the
  // standalone login page where the error message is visible, instead of the form
  // failing silently in the background on the current page.
  $current_path = \Drupal::service('path.current')->getPath();
  if ($current_path !== '/user/login') {
    $form['#action'] = \Drupal\Core\Url::fromRoute('user.login')->toString();
  }
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function compari_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Allow page templates based on the URL alias or path (e.g. page--how-it-works.html.twig or page--events.html.twig)
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  
  $path_to_use = ($alias != $current_path) ? $alias : $current_path;
  $path_to_use = ltrim($path_to_use, '/');
  
  if (!empty($path_to_use)) {
    // Convert /how-it-works to how_it_works
    $alias_clean = str_replace(['/', '-'], '_', $path_to_use);
    $suggestions[] = 'page__' . $alias_clean;
    
    // Also support hyphenated filenames like page--how-it-works
    $alias_hyphen = str_replace('/', '', $path_to_use);
    $suggestions[] = 'page__' . $alias_hyphen;
  }
}

/**
 * Implements hook_preprocess_commerce_store().
 *
 * On the full view mode (store detail page), loads store products from the
 * homepage_products view filtered by this store's ID, passing them to the
 * Twig template as $store_products.
 */
function compari_preprocess_commerce_store(array &$variables): void {
  if (!isset($variables['view_mode']) || $variables['view_mode'] !== 'full') {
    return;
  }

  /** @var \Drupal\commerce_store\Entity\Store $store */
  $store = $variables['commerce_store'];
  $store_id = (int) $store->id();

  // Run the homepage_products view, overriding filters at runtime.
  $view = \Drupal\views\Views::getView('homepage_products');
  if (!$view) {
    $variables['store_products'] = NULL;
    $variables['store_product_count'] = 0;
    return;
  }

  $view->setDisplay('default');

  // Remove the category filter so we see all products for this store.
  $view->removeHandler('default', 'filter', 'field_category_target_id');

  // Add a runtime filter on the stores entity reference field.
  $view->addHandler('default', 'filter', 'commerce_product__stores', 'stores_target_id', [
    'id'       => 'stores_target_id',
    'table'    => 'commerce_product__stores',
    'field'    => 'stores_target_id',
    'value'    => ['value' => $store_id],
    'operator' => '=',
    'group'    => 1,
    'exposed'  => FALSE,
  ]);

  $view->execute();

  $variables['store_products']      = $view->render();
  $variables['store_product_count'] = count($view->result);
}

/**
 * Implements hook_preprocess_views_view_fields().
 * For the homepage_products view, find the associated Brand node for the product's store.
 */
function compari_preprocess_views_view_fields__homepage_products(array &$variables): void {
  /** @var \Drupal\views\ResultRow $row */
  $row = $variables['row'];
  
  if (isset($row->_entity) && $row->_entity instanceof \Drupal\commerce_product\Entity\ProductInterface) {
    $product = $row->_entity;
    
    // Get the store referenced by the product.
    if ($product->hasField('stores') && !$product->get('stores')->isEmpty()) {
      $store_id = $product->get('stores')->target_id;
      
      // Look up the Brand node that references this store.
      $nids = \Drupal::entityQuery('node')
        ->condition('type', 'brand')
        ->condition('status', 1)
        ->condition('field_store', $store_id)
        ->accessCheck(FALSE)
        ->range(0, 1)
        ->execute();
        
      if (!empty($nids)) {
        $brand_nid = reset($nids);
        $brand = \Drupal\node\Entity\Node::load($brand_nid);
        if ($brand) {
          $variables['brand_name'] = $brand->label();
          $variables['brand_url'] = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
        }
      }
    }
  }
}

/**
 * Implements hook_preprocess_commerce_product().
 * Prepares brand, image, category, and price data for the styled product page.
 */
function compari_preprocess_commerce_product(array &$variables): void {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $variables['product_entity'] ?? NULL;
  $view_mode = $variables['view_mode'] ?? 'full';

  if (!$product || $view_mode !== 'full') {
    return;
  }

  $get_image_url = static function ($entity): string {
    if (!$entity) {
      return '';
    }
    if ($entity instanceof \Drupal\file\FileInterface) {
      return \Drupal::service('file_url_generator')->generateAbsoluteString($entity->getFileUri());
    }
    foreach (['field_media_image', 'field_product_image', 'field_image'] as $field_name) {
      if ($entity->hasField($field_name) && !$entity->get($field_name)->isEmpty()) {
        $file = $entity->get($field_name)->entity;
        if ($file) {
          return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
    }
    return '';
  };

  // --- Image ---
  $variables['product_image_url'] = '';
  foreach (['field_product_image', 'field_image', 'field_media_image'] as $field_name) {
    if (!$product->hasField($field_name) || $product->get($field_name)->isEmpty()) {
      continue;
    }
    $variables['product_image_url'] = $get_image_url($product->get($field_name)->entity);
    if ($variables['product_image_url']) {
      break;
    }
  }

  // --- Description ---
  $variables['product_description'] = '';
  foreach (['body', 'field_description'] as $field_name) {
    if ($product->hasField($field_name) && !$product->get($field_name)->isEmpty()) {
      $variables['product_description'] = trim(strip_tags((string) $product->get($field_name)->value));
      if ($variables['product_description']) {
        break;
      }
    }
  }

  // --- Category ---
  $variables['product_category'] = '';
  $category_id = 0;
  if ($product->hasField('field_product_category') && !$product->get('field_product_category')->isEmpty()) {
    $category_item = $product->get('field_product_category')->first();
    $category_id = (int) ($category_item->target_id ?? 0);
    $category = $category_item->entity;
    if (!$category && $category_id) {
      $category = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($category_id);
    }
    if ($category) {
      $category_id = (int) $category->id();
      $variables['product_category'] = $category->label();
    }
  }

  // --- Brand ---
  $variables['brand_name'] = '';
  $variables['brand_url'] = '';
  if ($product->hasField('field_product_brand') && !$product->get('field_product_brand')->isEmpty()) {
    $brand = $product->get('field_product_brand')->entity;
    if ($brand) {
      $variables['brand_name'] = $brand->label();
      $variables['brand_url'] = $brand->toUrl()->toString();
    }
  }
  elseif ($product->hasField('stores') && !$product->get('stores')->isEmpty()) {
    $store_id = $product->get('stores')->target_id;
    $brand_nids = \Drupal::entityQuery('node')
      ->condition('type', 'brand')
      ->condition('status', 1)
      ->condition('field_store', $store_id)
      ->accessCheck(FALSE)
      ->range(0, 1)
      ->execute();
    if (!empty($brand_nids)) {
      $brand_nid = reset($brand_nids);
      $brand = \Drupal::entityTypeManager()->getStorage('node')->load($brand_nid);
      if ($brand) {
        $variables['brand_name'] = $brand->label();
        $variables['brand_url'] = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
      }
    }
  }

  // --- Best price from default variation ---
  $variables['product_price'] = '';
  $variables['product_price_raw'] = 0;
  $default_variation = $product->getDefaultVariation();
  if ($default_variation) {
    $price = $default_variation->getPrice();
    if ($price) {
      $variables['product_price_raw'] = (float) $price->getNumber();
      $formatted = \Drupal::service('commerce_price.currency_formatter')->format(
        $price->getNumber(),
        $price->getCurrencyCode()
      );
      $variables['product_price'] = $formatted;
    }
  }

  // --- All variations with prices for the vendor comparison table ---
  $variables['product_variations'] = [];
  foreach ($product->getVariations() as $variation) {
    $price = $variation->getPrice();
    $vendor_brand_name = '';
    $vendor_brand_url = '';
    if ($variation->hasField('field_vendor_brand') && !$variation->get('field_vendor_brand')->isEmpty()) {
      $vb = $variation->get('field_vendor_brand')->entity;
      if ($vb) {
        $vendor_brand_name = $vb->label();
        $vendor_nid = $vb->id();
        $vendor_brand_url = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $vendor_nid);
      }
    }
    // Fall back to the store-derived brand if variation has no brand.
    if (!$vendor_brand_name) {
      $vendor_brand_name = $variables['brand_name'];
      $vendor_brand_url = $variables['brand_url'];
    }
    $variables['product_variations'][] = [
      'sku'        => $variation->getSku(),
      'title'      => $variation->getTitle(),
      'price_raw'  => $price ? (float) $price->getNumber() : 0,
      'price'      => $price ? \Drupal::service('commerce_price.currency_formatter')->format($price->getNumber(), $price->getCurrencyCode()) : '',
      'brand_name' => $vendor_brand_name,
      'brand_url'  => $vendor_brand_url,
    ];
  }

  // Sort variations cheapest first.
  usort($variables['product_variations'], fn($a, $b) => $a['price_raw'] <=> $b['price_raw']);

  // --- Related products for the You May Check section ---
  $variables['related_products'] = [];
  if ($category_id) {
    $related_ids = \Drupal::entityQuery('commerce_product')
      ->condition('field_product_category', $category_id)
      ->condition('product_id', $product->id(), '<>')
      ->accessCheck(TRUE)
      ->range(0, 5)
      ->execute();
    foreach (\Drupal::entityTypeManager()->getStorage('commerce_product')->loadMultiple($related_ids) as $related) {
      $related_variation = $related->getDefaultVariation();
      $related_price = $related_variation ? $related_variation->getPrice() : NULL;
      $related_image_url = '';
      foreach (['field_product_image', 'field_image', 'field_media_image'] as $field_name) {
        if ($related->hasField($field_name) && !$related->get($field_name)->isEmpty()) {
          $related_image_url = $get_image_url($related->get($field_name)->entity);
          if ($related_image_url) {
            break;
          }
        }
      }
      $variables['related_products'][] = [
        'id' => $related->id(),
        'title' => $related->label(),
        'image_url' => $related_image_url,
        'price' => $related_price ? \Drupal::service('commerce_price.currency_formatter')->format($related_price->getNumber(), $related_price->getCurrencyCode()) : '',
      ];
    }
  }
}
