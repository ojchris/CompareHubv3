<?php

declare(strict_types=1);

/**
 * @file
 * Functions to support theming in the compari theme.
 */

/**
 * Implements hook_preprocess_HOOK() for html.html.twig.
 */
function compari_preprocess_html(array &$variables): void {

}


/**
 * Implements hook_preprocess_HOOK() for node.html.twig.
 */
function compari_preprocess_node(array &$variables): void {
  /** @var \Drupal\node\Entity\Node $node */
  $node = $variables['node'];

  // Only run for Brand nodes on the full view mode.
  if ($node->bundle() === 'brand' && $variables['view_mode'] === 'full') {
    $variables['store_products'] = NULL;
    $variables['store_product_count'] = 0;

    // Check if the Brand has a store referenced.
    if ($node->hasField('field_store') && !$node->get('field_store')->isEmpty()) {
      $store_id = (int) $node->get('field_store')->target_id;

      // Run the homepage_products view, overriding filters at runtime.
      $view = \Drupal\views\Views::getView('homepage_products');
      if ($view) {
        $view->setDisplay('default');

        // Remove the category filter so we see all products for this store.
        $view->removeHandler('default', 'filter', 'field_category_target_id');
        
        // Add a runtime filter on the stores entity reference field.
        $view->addHandler('default', 'filter', 'commerce_product__stores', 'stores_target_id', [
          'id'       => 'stores_target_id',
          'table'    => 'commerce_product__stores',
          'field'    => 'stores_target_id',
          'value'    => ['value' => $store_id],
          'operator' => '=',
          'group'    => 1,
          'exposed'  => FALSE,
        ]);

        $view->execute();

        $variables['store_products'] = $view->render();
        $variables['store_product_count'] = count($view->result);
      }
    }
  }
}

/**
 * Implements hook_form_alter() for views exposed forms.
 */
function compari_form_views_exposed_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Check if this is the discover search form
  if ($form['#id'] == 'views-exposed-form-discover-page-1' || $form['#id'] == 'views-exposed-form-discover-search') {
    
    // 1. Style the main form container — stacked on mobile, row on desktop
    $form['#attributes']['class'][] = 'bg-white/10 backdrop-blur-sm rounded-[30px] flex flex-col sm:flex-row items-center gap-3 relative h-auto sm:h-[66px] p-4 sm:p-0 sm:px-5 w-full sm:w-[min(760px,100%)]';

    // 2. Define the input styling
    $base_input_classes = 'bg-[#f9fafb] rounded-[14px] px-4 font-work text-[#808793] outline-none border-none cursor-pointer text-[14px] h-[44px] sm:h-[32px] w-full';

    // 3. Apply styles and placeholders to each field
    $fields = [
      'product_name' => [
        'placeholder' => 'Search product name..',
        'width' => 'w-full sm:flex-[1_1_313px]',
      ],
      'product_category' => [
        'placeholder' => 'By Category...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'product_source' => [
        'placeholder' => 'By Brand...',
        'width' => 'w-full sm:w-[131px]',
      ],
      'brand_location' => [
        'placeholder' => 'By Location...',
        'width' => 'w-full sm:w-[131px]',
      ],
    ];

     foreach ($fields as $field_name => $config) {
      if (isset($form[$field_name])) {
        $form[$field_name]['#attributes']['class'][] = $base_input_classes;
        $form[$field_name]['#attributes']['placeholder'] = t($config['placeholder']);
        $form[$field_name]['#wrapper_attributes']['class'][] = 'm-0 ' . $config['width'];
      }
    }

    // 4. Style the Submit button — full width tap target on mobile, fixed width on desktop
    if (isset($form['actions']['submit'])) {
      $form['actions']['submit']['#attributes']['class'][] = 'bg-[#155dfc] rounded-[14px] font-work font-medium text-white hover:bg-[#1447e6] transition-colors shrink-0 w-full sm:w-[141px] h-[44px] sm:h-[32px] text-[14px] sm:text-[12px]';
      $form['actions']['#attributes']['class'][] = 'w-full sm:w-auto';
    }
  }
}

/**
 * Implements hook_preprocess_page().
 * Passes the current user's display name and first name to all page templates.
 */
function compari_preprocess_page(array &$variables): void {
  $account = \Drupal::currentUser();
  if ($account->isAuthenticated()) {
    $name = $account->getDisplayName();
    $variables['current_user_name'] = $name;
    // First name only (everything before the first space)
    $parts = explode(' ', $name);
    $variables['current_user_first_name'] = $parts[0];
    // Two-letter initials: first char of first + last word
    $first = mb_substr($parts[0], 0, 1);
    $last  = count($parts) > 1 ? mb_substr(end($parts), 0, 1) : '';
    $variables['current_user_initials'] = mb_strtoupper($first . $last);
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for user_login_form.
 */
function compari_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  $current_path = \Drupal::service('path.current')->getPath();
  
  // Set the base action URL. If not on the standalone login page, force it to /user/login
  // so error messages show up properly on failure.
  $action = ($current_path !== '/user/login') ? \Drupal\Core\Url::fromRoute('user.login')->toString() : $form['#action'];
  
  // Always redirect to the /account dashboard upon successful login.
  $form['#action'] = $action . (strpos($action, '?') !== FALSE ? '&' : '?') . 'destination=/account';
}

/**
 * Implements hook_theme_suggestions_page_alter().
 */
function compari_theme_suggestions_page_alter(array &$suggestions, array $variables) {
  // Allow page templates based on the URL alias or path (e.g. page--how-it-works.html.twig or page--events.html.twig)
  $current_path = \Drupal::service('path.current')->getPath();
  $alias = \Drupal::service('path_alias.manager')->getAliasByPath($current_path);
  
  $path_to_use = ($alias != $current_path) ? $alias : $current_path;
  $path_to_use = ltrim($path_to_use, '/');
  
  if (!empty($path_to_use)) {
    // Convert /how-it-works to how_it_works
    $alias_clean = str_replace(['/', '-'], '_', $path_to_use);
    $suggestions[] = 'page__' . $alias_clean;
    
    // Also support hyphenated filenames like page--how-it-works
    $alias_hyphen = str_replace('/', '', $path_to_use);
    $suggestions[] = 'page__' . $alias_hyphen;
  }
}

/**
 * Implements hook_preprocess_commerce_store().
 *
 * On the full view mode (store detail page), loads store products from the
 * homepage_products view filtered by this store's ID, passing them to the
 * Twig template as $store_products.
 */
function compari_preprocess_commerce_store(array &$variables): void {
  if (!isset($variables['view_mode']) || $variables['view_mode'] !== 'full') {
    return;
  }

  /** @var \Drupal\commerce_store\Entity\Store $store */
  $store = $variables['commerce_store'];
  $store_id = (int) $store->id();

  // Run the homepage_products view, overriding filters at runtime.
  $view = \Drupal\views\Views::getView('homepage_products');
  if (!$view) {
    $variables['store_products'] = NULL;
    $variables['store_product_count'] = 0;
    return;
  }

  $view->setDisplay('default');

  // Remove the category filter so we see all products for this store.
  $view->removeHandler('default', 'filter', 'field_category_target_id');

  // Add a runtime filter on the stores entity reference field.
  $view->addHandler('default', 'filter', 'commerce_product__stores', 'stores_target_id', [
    'id'       => 'stores_target_id',
    'table'    => 'commerce_product__stores',
    'field'    => 'stores_target_id',
    'value'    => ['value' => $store_id],
    'operator' => '=',
    'group'    => 1,
    'exposed'  => FALSE,
  ]);

  $view->execute();

  $variables['store_products']      = $view->render();
  $variables['store_product_count'] = count($view->result);
}

/**
 * Implements hook_preprocess_views_view_fields().
 * For the homepage_products view, find the associated Brand node for the product's store.
 */
function compari_preprocess_views_view_fields__homepage_products(array &$variables): void {
  /** @var \Drupal\views\ResultRow $row */
  $row = $variables['row'];

  $product = NULL;

  // The row entity can be either the product or a variation depending on
  // how the View relationship is set up.
  if (isset($row->_entity)) {
    $entity = $row->_entity;
    if ($entity instanceof \Drupal\commerce_product\Entity\ProductInterface) {
      $product = $entity;
    }
    elseif ($entity instanceof \Drupal\commerce_product\Entity\ProductVariationInterface) {
      $product = $entity->getProduct();
    }
  }

  if (!$product) {
    return;
  }

  // --- Find the cheapest variation and its brand ---
  $cheapest_variation = NULL;
  $cheapest_price = PHP_FLOAT_MAX;

  foreach ($product->getVariations() as $variation) {
    $price = $variation->getPrice();
    if (!$price) {
      continue;
    }
    $amount = (float) $price->getNumber();
    if ($amount < $cheapest_price) {
      $cheapest_price = $amount;
      $cheapest_variation = $variation;
    }
  }

  // Fallback to default variation if none have prices.
  if (!$cheapest_variation) {
    $cheapest_variation = $product->getDefaultVariation();
  }

  // --- Resolve brand from the cheapest variation's field_vendor_brand ---
  $variables['brand_name'] = '';
  $variables['brand_url'] = '';

  if ($cheapest_variation && $cheapest_variation->hasField('field_vendor_brand') && !$cheapest_variation->get('field_vendor_brand')->isEmpty()) {
    $store_entity = $cheapest_variation->get('field_vendor_brand')->entity;

    if ($store_entity && $store_entity->getEntityTypeId() === 'commerce_store') {
      // Fallback to store label.
      $variables['brand_name'] = $store_entity->label();

      // Look up the Brand node referencing this store.
      $brand_nids = \Drupal::entityQuery('node')
        ->condition('type', 'brand')
        ->condition('status', 1)
        ->condition('field_store', $store_entity->id())
        ->accessCheck(FALSE)
        ->range(0, 1)
        ->execute();

      if (!empty($brand_nids)) {
        $brand_nid = reset($brand_nids);
        $brand_node = \Drupal\node\Entity\Node::load($brand_nid);
        if ($brand_node) {
          $variables['brand_name'] = $brand_node->label();
          $variables['brand_url'] = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
        }
      }
    }
  }

  // Also expose the cheapest price so the Twig template can use it.
  if ($cheapest_variation) {
    $price = $cheapest_variation->getPrice();
    if ($price) {
      $variables['cheapest_price'] = \Drupal::service('commerce_price.currency_formatter')
        ->format($price->getNumber(), $price->getCurrencyCode());
    }
  }

  // Wishlist flag state for the ♡ Save button.
  _compari_add_wishlist_flag_data($variables, (int) $product->id());
}


/**
 * Helper: embeds flag_token + is_wishlisted for a product card.
 * Uses a static cache so the DB is queried only once per request.
 */
function _compari_add_wishlist_flag_data(array &$variables, int $product_id): void {
  static $wishlisted_map = NULL;

  if ($wishlisted_map === NULL) {
    $wishlisted_map = [];
    $account = \Drupal::currentUser();
    if (!$account->isAnonymous()) {
      try {
        $ids = \Drupal::database()
          ->select('flagging', 'f')
          ->fields('f', ['entity_id'])
          ->condition('f.flag_id', 'save')
          ->condition('f.uid', $account->id())
          ->condition('f.entity_type', 'commerce_product')
          ->execute()
          ->fetchCol();
        $wishlisted_map = array_flip(array_map('intval', $ids));
      }
      catch (\Exception $e) {
        // Flag table not available yet — silently skip.
      }
    }
  }

  $is_wishlisted = isset($wishlisted_map[$product_id]);
  $variables['is_wishlisted'] = $is_wishlisted;

  // Generate the Flag module AJAX URLs. Url::fromRoute() auto-appends ?token=
  // for routes declared with _csrf_token: TRUE.
  try {
    $variables['flag_url'] = \Drupal\Core\Url::fromRoute('flag.action_link_flag', [
      'flag'      => 'save',
      'entity_id' => $product_id,
      'view_mode' => 'full',
    ])->toString();
    $variables['unflag_url'] = \Drupal\Core\Url::fromRoute('flag.action_link_unflag', [
      'flag'      => 'save',
      'entity_id' => $product_id,
      'view_mode' => 'full',
    ])->toString();
  }
  catch (\Exception $e) {
    $variables['flag_url']   = '';
    $variables['unflag_url'] = '';
  }
}



/**
 * Implements hook_preprocess_commerce_product().
 * Prepares brand, image, category, and price data for the styled product page.
 */
function compari_preprocess_commerce_product(array &$variables): void {
  /** @var \Drupal\commerce_product\Entity\ProductInterface $product */
  $product = $variables['product_entity'] ?? NULL;
  $view_mode = $variables['view_mode'] ?? 'full';

  if (!$product || $view_mode !== 'full') {
    return;
  }

  $get_image_url = static function ($entity): string {
    if (!$entity) {
      return '';
    }
    if ($entity instanceof \Drupal\file\FileInterface) {
      return \Drupal::service('file_url_generator')->generateAbsoluteString($entity->getFileUri());
    }
    foreach (['field_media_image', 'field_product_image', 'field_image'] as $field_name) {
      if ($entity->hasField($field_name) && !$entity->get($field_name)->isEmpty()) {
        $file = $entity->get($field_name)->entity;
        if ($file) {
          return \Drupal::service('file_url_generator')->generateAbsoluteString($file->getFileUri());
        }
      }
    }
    return '';
  };

  // --- Image ---
  $variables['product_image_url'] = '';
  foreach (['field_product_image', 'field_image', 'field_media_image'] as $field_name) {
    if (!$product->hasField($field_name) || $product->get($field_name)->isEmpty()) {
      continue;
    }
    $variables['product_image_url'] = $get_image_url($product->get($field_name)->entity);
    if ($variables['product_image_url']) {
      break;
    }
  }

  // --- Description ---
  $variables['product_description'] = '';
  foreach (['body', 'field_description'] as $field_name) {
    if ($product->hasField($field_name) && !$product->get($field_name)->isEmpty()) {
      $variables['product_description'] = trim(strip_tags((string) $product->get($field_name)->value));
      if ($variables['product_description']) {
        break;
      }
    }
  }

  // --- Category ---
  $variables['product_category'] = '';
  $category_id = 0;
  if ($product->hasField('field_category') && !$product->get('field_category')->isEmpty()) {
    $category_item = $product->get('field_category')->first();
    $category_id = (int) ($category_item->target_id ?? 0);
    $category = $category_item->entity;
    if (!$category && $category_id) {
      $category = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($category_id);
    }
    if ($category) {
      $category_id = (int) $category->id();
      $variables['product_category'] = $category->label();
    }
  }

  // --- Brand ---
  $variables['brand_name'] = '';
  $variables['brand_url'] = '';
  if ($product->hasField('field_product_brand') && !$product->get('field_product_brand')->isEmpty()) {
    $brand = $product->get('field_product_brand')->entity;
    if ($brand) {
      $variables['brand_name'] = $brand->label();
      $variables['brand_url'] = $brand->toUrl()->toString();
    }
  }
  elseif ($product->hasField('stores') && !$product->get('stores')->isEmpty()) {
    $store_id = $product->get('stores')->target_id;
    $brand_nids = \Drupal::entityQuery('node')
      ->condition('type', 'brand')
      ->condition('status', 1)
      ->condition('field_store', $store_id)
      ->accessCheck(FALSE)
      ->range(0, 1)
      ->execute();
    if (!empty($brand_nids)) {
      $brand_nid = reset($brand_nids);
      $brand = \Drupal::entityTypeManager()->getStorage('node')->load($brand_nid);
      if ($brand) {
        $variables['brand_name'] = $brand->label();
        $variables['brand_url'] = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
      }
    }
  }

  // --- Best price: find the cheapest variation, not just the default ---
  $variables['product_price'] = '';
  $variables['product_price_raw'] = 0;
  $cheapest_variation = NULL;
  $lowest = PHP_FLOAT_MAX;

  foreach ($product->getVariations() as $variation) {
    $price = $variation->getPrice();
    if (!$price) {
      continue;
    }
    $amount = (float) $price->getNumber();
    if ($amount < $lowest) {
      $lowest = $amount;
      $cheapest_variation = $variation;
    }
  }

  // Fallback to default variation if no priced variation found.
  if (!$cheapest_variation) {
    $cheapest_variation = $product->getDefaultVariation();
  }

  if ($cheapest_variation) {
    $price = $cheapest_variation->getPrice();
    if ($price) {
      $variables['product_price_raw'] = (float) $price->getNumber();
      $variables['product_price'] = \Drupal::service('commerce_price.currency_formatter')->format(
        $price->getNumber(),
        $price->getCurrencyCode()
      );
    }
  }

  // --- All variations with prices for the vendor comparison table ---
  $variables['product_variations'] = [];
  foreach ($product->getVariations() as $variation) {
    $price = $variation->getPrice();
    $vendor_brand_name = '';
    $vendor_brand_url = '';
    if ($variation->hasField('field_vendor_brand') && !$variation->get('field_vendor_brand')->isEmpty()) {
      $store_entity = $variation->get('field_vendor_brand')->entity;
      if ($store_entity && $store_entity->getEntityTypeId() === 'commerce_store') {
        $vendor_brand_name = $store_entity->label(); // Fallback name
        
        $brand_nids = \Drupal::entityQuery('node')
          ->condition('type', 'brand')
          ->condition('status', 1)
          ->condition('field_store', $store_entity->id())
          ->accessCheck(FALSE)
          ->range(0, 1)
          ->execute();
          
        if (!empty($brand_nids)) {
          $brand_nid = reset($brand_nids);
          $brand_node = \Drupal::entityTypeManager()->getStorage('node')->load($brand_nid);
          if ($brand_node) {
            $vendor_brand_name = $brand_node->label();
            $vendor_brand_url = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
          }
        }
      }
    }
    // Fallback to the store-derived brand if variation has no brand.
    if (!$vendor_brand_name) {
      $vendor_brand_name = $variables['brand_name'];
      $vendor_brand_url = $variables['brand_url'];
    }

    // --- Location: read from the brand node's address/city field ---
    $location = '';
    if (!empty($brand_node)) {
      // Try common field names for location/city on the brand node.
      foreach (['field_city', 'field_location', 'field_address'] as $loc_field) {
        if ($brand_node->hasField($loc_field) && !$brand_node->get($loc_field)->isEmpty()) {
          $loc_item = $brand_node->get($loc_field)->first();
          // Address field (address module) stores locality in ->locality.
          if (isset($loc_item->locality)) {
            $location = $loc_item->locality;
          } else {
            $location = (string) $loc_item->value;
          }
          if ($location) break;
        }
      }
    }

    // --- Avatar colour: light bg + dark text, matching compare.html palette ---
    $avatar_colors = [
      ['bg' => '#ffe4e6', 'text' => '#c70036'],
      ['bg' => '#fef3c6', 'text' => '#bb4d00'],
      ['bg' => '#ecfcca', 'text' => '#497d00'],
      ['bg' => '#dbeafe', 'text' => '#1447e6'],
      ['bg' => '#ede9fe', 'text' => '#6d28d9'],
      ['bg' => '#d1fae5', 'text' => '#065f46'],
    ];
    // Named vendors get consistent colours (matching Figma VENDOR_COLORS).
    $vendor_colors = [
      'ELECTROMART' => ['bg' => '#dcfce7', 'text' => '#008236'],
      'GADGETPRO'   => ['bg' => '#ffedd4', 'text' => '#ca3500'],
      'TECHSTORE'   => ['bg' => '#dbeafe', 'text' => '#1447e6'],
      'SMARTBUY'    => ['bg' => '#ede9fe', 'text' => '#6d28d9'],
      'DIGIZONE'    => ['bg' => '#fef3c6', 'text' => '#bb4d00'],
    ];
    $upper_name = mb_strtoupper($vendor_brand_name);
    $first_char = $vendor_brand_name ? mb_strtoupper(mb_substr($vendor_brand_name, 0, 1)) : 'V';
    if (isset($vendor_colors[$upper_name])) {
      $color_pair = $vendor_colors[$upper_name];
    } else {
      $color_pair = $avatar_colors[ord($first_char) % count($avatar_colors)];
    }

    $variables['product_variations'][] = [
      'sku'          => $variation->getSku(),
      'title'        => $variation->getTitle(),
      'price_raw'    => $price ? (float) $price->getNumber() : 0,
      'price'        => $price ? \Drupal::service('commerce_price.currency_formatter')->format($price->getNumber(), $price->getCurrencyCode()) : '',
      'brand_name'   => $vendor_brand_name,
      'brand_url'    => $vendor_brand_url,
      'location'     => $location,
      'avatar_bg'    => $color_pair['bg'],
      'avatar_text'  => $color_pair['text'],
      'initial'      => $first_char,
    ];
  }

  // Sort variations cheapest first.
  usort($variables['product_variations'], fn($a, $b) => $a['price_raw'] <=> $b['price_raw']);

  // --- Related products for the You May Check section ---
  $variables['related_products'] = [];
  if ($category_id) {
    $related_ids = \Drupal::entityQuery('commerce_product')
      ->condition('field_product_category', $category_id)
      ->condition('product_id', $product->id(), '<>')
      ->accessCheck(TRUE)
      ->range(0, 5)
      ->execute();
    foreach (\Drupal::entityTypeManager()->getStorage('commerce_product')->loadMultiple($related_ids) as $related) {
      $related_variation = $related->getDefaultVariation();
      $related_price = $related_variation ? $related_variation->getPrice() : NULL;
      $related_image_url = '';
      foreach (['field_product_image', 'field_image', 'field_media_image'] as $field_name) {
        if ($related->hasField($field_name) && !$related->get($field_name)->isEmpty()) {
          $related_image_url = $get_image_url($related->get($field_name)->entity);
          if ($related_image_url) {
            break;
          }
        }
      }
      $variables['related_products'][] = [
        'id' => $related->id(),
        'title' => $related->label(),
        'image_url' => $related_image_url,
        'price' => $related_price ? \Drupal::service('commerce_price.currency_formatter')->format($related_price->getNumber(), $related_price->getCurrencyCode()) : '',
      ];
    }
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function compari_preprocess_views_view_fields__compare_product_variations(array &$variables): void {
  $row = $variables['row'];
  
  // Try to get the variation entity from the row
  $variation = $row->_entity ?? NULL;
  
  if ($variation && $variation instanceof \Drupal\commerce_product\Entity\ProductVariationInterface) {
    // Get product category
    $product = $variation->getProduct();
    $category_name = '';
    if ($product && $product->hasField('field_category') && !$product->get('field_category')->isEmpty()) {
      $category_item = $product->get('field_category')->first();
      $category = $category_item->entity;
      if (!$category && !empty($category_item->target_id)) {
        $category = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($category_item->target_id);
      }
      if ($category) {
        $category_name = $category->label();
      }
    }
    $variables['category'] = $category_name;

    // Automatically flag this product for Compare History.
    if ($product) {
      try {
        $flag_service = \Drupal::service('flag');
        $flag = $flag_service->getFlagById('compare_history');
        $account = \Drupal::currentUser();
        
        if ($flag) {
          // If already flagged, unflag first to update the timestamp to 'now'.
          if ($flag->isFlagged($product, $account)) {
            $flag_service->unflag($flag, $product, $account);
          }
          $flag_service->flag($flag, $product, $account);
        }
      } catch (\Exception $e) {
        // Silently fail if flagging is not permitted.
      }
    }

    // Populate vendor and location from field_vendor_brand
    $vendor_name = '';
    $location_name = '';
    
    if ($variation->hasField('field_vendor_brand') && !$variation->get('field_vendor_brand')->isEmpty()) {
      $store_entity = $variation->get('field_vendor_brand')->entity;
      if ($store_entity && $store_entity->getEntityTypeId() === 'commerce_store') {
        $vendor_name = $store_entity->label(); // Fallback name
        
        // Find the brand node that references this store
        $brand_nids = \Drupal::entityQuery('node')
          ->condition('type', 'brand')
          ->condition('status', 1)
          ->condition('field_store', $store_entity->id())
          ->accessCheck(FALSE)
          ->range(0, 1)
          ->execute();
          
        if (!empty($brand_nids)) {
          $brand_nid = reset($brand_nids);
          $brand_node = \Drupal::entityTypeManager()->getStorage('node')->load($brand_nid);
          if ($brand_node) {
            $vendor_name = $brand_node->label();
            if ($brand_node->hasField('field_location') && !$brand_node->get('field_location')->isEmpty()) {
              $location_name = $brand_node->get('field_location')->value;
            }
          }
        }
      }
    }
    
    $variables['vendor'] = $vendor_name;
    $variables['location'] = $location_name;
    
    // Fallback store name just in case JS needs it
    $variables['store'] = $vendor_name;
  }
}

/**
 * Implements hook_preprocess_views_view_fields__discover().
 * Mirrors the homepage hook: cheapest price + brand from variation,
 * plus vendor_count (number of variations = number of vendors).
 */
function compari_preprocess_views_view_fields__discover(array &$variables): void {
  $row = $variables['row'];

  $product = NULL;
  if (isset($row->_entity)) {
    $entity = $row->_entity;
    if ($entity instanceof \Drupal\commerce_product\Entity\ProductInterface) {
      $product = $entity;
    }
    elseif ($entity instanceof \Drupal\commerce_product\Entity\ProductVariationInterface) {
      $product = $entity->getProduct();
    }
  }

  if (!$product) {
    return;
  }

  $variations = $product->getVariations();

  // --- Vendor count ---
  $variables['vendor_count'] = count($variations);

  // --- Find cheapest variation ---
  $cheapest_variation = NULL;
  $lowest = PHP_FLOAT_MAX;
  foreach ($variations as $variation) {
    $price = $variation->getPrice();
    if (!$price) continue;
    $amount = (float) $price->getNumber();
    if ($amount < $lowest) {
      $lowest = $amount;
      $cheapest_variation = $variation;
    }
  }
  if (!$cheapest_variation) {
    $cheapest_variation = $product->getDefaultVariation();
  }

  // --- Cheapest price ---
  $variables['cheapest_price'] = '';
  if ($cheapest_variation) {
    $price = $cheapest_variation->getPrice();
    if ($price) {
      $variables['cheapest_price'] = \Drupal::service('commerce_price.currency_formatter')
        ->format($price->getNumber(), $price->getCurrencyCode());
    }
  }

  // --- Brand from cheapest variation's field_vendor_brand ---
  $variables['brand_name'] = '';
  $variables['brand_url']  = '';

  if ($cheapest_variation && $cheapest_variation->hasField('field_vendor_brand') && !$cheapest_variation->get('field_vendor_brand')->isEmpty()) {
    $store_entity = $cheapest_variation->get('field_vendor_brand')->entity;
    if ($store_entity && $store_entity->getEntityTypeId() === 'commerce_store') {
      $variables['brand_name'] = $store_entity->label();
      $brand_nids = \Drupal::entityQuery('node')
        ->condition('type', 'brand')
        ->condition('status', 1)
        ->condition('field_store', $store_entity->id())
        ->accessCheck(FALSE)
        ->range(0, 1)
        ->execute();
      if (!empty($brand_nids)) {
        $brand_nid = reset($brand_nids);
        $brand_node = \Drupal\node\Entity\Node::load($brand_nid);
        if ($brand_node) {
          $variables['brand_name'] = $brand_node->label();
          $variables['brand_url']  = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
        }
      }
    }
  }

  // Wishlist flag state for the ♡ Save button.
  _compari_add_wishlist_flag_data($variables, (int) $product->id());
}


/**
 * Implements hook_preprocess_views_view_fields__wishlist_products().
 * Mirrors the homepage/discover hooks: cheapest price + brand from variation.
 */
function compari_preprocess_views_view_fields__wishlist_products(array &$variables): void {
  $row = $variables['row'];

  $product = NULL;
  if (isset($row->_entity)) {
    $entity = $row->_entity;
    if ($entity instanceof \Drupal\commerce_product\Entity\ProductInterface) {
      $product = $entity;
    }
    elseif ($entity instanceof \Drupal\commerce_product\Entity\ProductVariationInterface) {
      $product = $entity->getProduct();
    }
  }

  if (!$product) {
    return;
  }

  $variations = $product->getVariations();

  // --- Find cheapest variation ---
  $cheapest_variation = NULL;
  $lowest = PHP_FLOAT_MAX;
  foreach ($variations as $variation) {
    $price = $variation->getPrice();
    if (!$price) continue;
    $amount = (float) $price->getNumber();
    if ($amount < $lowest) {
      $lowest = $amount;
      $cheapest_variation = $variation;
    }
  }
  if (!$cheapest_variation) {
    $cheapest_variation = $product->getDefaultVariation();
  }

  // --- Cheapest price ---
  $variables['cheapest_price'] = '';
  if ($cheapest_variation) {
    $price = $cheapest_variation->getPrice();
    if ($price) {
      $variables['cheapest_price'] = \Drupal::service('commerce_price.currency_formatter')
        ->format($price->getNumber(), $price->getCurrencyCode());
    }
  }

  // --- Brand ---
  $variables['brand_name'] = '';
  $variables['brand_url']  = '';
  if ($cheapest_variation && $cheapest_variation->hasField('field_vendor_brand') && !$cheapest_variation->get('field_vendor_brand')->isEmpty()) {
    $store_entity = $cheapest_variation->get('field_vendor_brand')->entity;
    if ($store_entity && $store_entity->getEntityTypeId() === 'commerce_store') {
      $variables['brand_name'] = $store_entity->label();
      $brand_nids = \Drupal::entityQuery('node')
        ->condition('type', 'brand')
        ->condition('status', 1)
        ->condition('field_store', $store_entity->id())
        ->accessCheck(FALSE)
        ->range(0, 1)
        ->execute();
      if (!empty($brand_nids)) {
        $brand_nid = reset($brand_nids);
        $brand_node = \Drupal\node\Entity\Node::load($brand_nid);
        if ($brand_node) {
          $variables['brand_name'] = $brand_node->label();
          $variables['brand_url']  = \Drupal::service('path_alias.manager')->getAliasByPath('/node/' . $brand_nid);
        }
      }
    }
  }

  // Always wishlisted on this page (View only shows flagged items).
  // Call the helper to generate the flag_link correctly.
  _compari_add_wishlist_flag_data($variables, (int) $product->id());
}


/**
 * Implements hook_page_attachments().
 * Passes the current user's wishlisted product IDs to drupalSettings so JS
 * can keep ♡ Save button states consistent across all cards on the page.
 */
function compari_page_attachments(array &$attachments): void {
  $account = \Drupal::currentUser();
  if ($account->isAnonymous()) {
    return;
  }
  try {
    $ids = \Drupal::database()
      ->select('flagging', 'f')
      ->fields('f', ['entity_id'])
      ->condition('f.flag_id', 'save') // CORRECT FLAG ID
      ->condition('f.uid', $account->id())
      ->condition('f.entity_type', 'commerce_product')
      ->execute()
      ->fetchCol();
    $attachments['#attached']['drupalSettings']['comparehub']['wishlisted_ids'] =
      array_values(array_map('intval', $ids));
      
    // IMPORTANT: Cache per user, and invalidate when flags change!
    $attachments['#cache']['contexts'][] = 'user';
    $attachments['#cache']['tags'][] = 'flagging_list';
  }
  catch (\Exception $e) {
    // Flag table not available yet — silently skip.
  }
}
/**
 * Implements hook_preprocess_views_view_fields__compare_history().
 * Injects a resolved image URL for each product in the compare session row.
 */
function compari_preprocess_views_view_fields__compare_history(array &$variables): void {
  $row = $variables['row'];
  if (!isset($row->_entity)) {
    return;
  }

  $session = $row->_entity;
  $file_url_generator = \Drupal::service('file_url_generator');
  $product_images = [];

  foreach ($session->get('product_ids') as $item) {
    $product = $item->entity;
    if (!$product) {
      continue;
    }

    $image_url = NULL;

    // Helper closure: resolve a file URI from a field (direct image or media reference).
    $resolve_image = function ($entity, $field_name) use ($file_url_generator) {
      if (!$entity->hasField($field_name) || $entity->get($field_name)->isEmpty()) {
        return NULL;
      }
      $field_item = $entity->get($field_name)->first();
      $referenced = $field_item->entity;
      if (!$referenced) {
        return NULL;
      }
      // Direct file entity.
      if ($referenced->getEntityTypeId() === 'file') {
        return $file_url_generator->generateString($referenced->getFileUri());
      }
      // Media entity — look inside it for the source file.
      if ($referenced->getEntityTypeId() === 'media') {
        foreach (['field_media_image', 'field_image', 'thumbnail'] as $media_field) {
          if ($referenced->hasField($media_field) && !$referenced->get($media_field)->isEmpty()) {
            $file = $referenced->get($media_field)->entity;
            if ($file) {
              return $file_url_generator->generateString($file->getFileUri());
            }
          }
        }
      }
      return NULL;
    };

    // Try product-level image fields.
    foreach (['field_product_image', 'field_image'] as $field) {
      $image_url = $resolve_image($product, $field);
      if ($image_url) break;
    }

    // Fall back to first variation's image fields.
    if (!$image_url) {
      foreach ($product->getVariations() as $variation) {
        foreach (['field_product_image', 'field_image'] as $field) {
          $image_url = $resolve_image($variation, $field);
          if ($image_url) break 2;
        }
      }
    }

    $product_images[$product->id()] = [
      'label'     => $product->label(),
      'image_url' => $image_url,
    ];
  }

  $variables['product_images'] = $product_images;
}
