{#
/**
 * @file
 * Theme override for an event node teaser — used by the Horizontal Event Calendar module.
 *
 * Available variables:
 *  - node: The node entity.
 *  - label: The node title (may include debug markup in Twig debug mode).
 *  - url: The node URL.
 *  - attributes: HTML attributes for the wrapper (we add our own below).
 */
#}
{%
  set img_uri = node.field_images.entity ? node.field_images.entity.uri.value : (node.field_image.entity ? node.field_image.entity.uri.value : null)
%}
{%
  set img_url = img_uri ? file_url(img_uri) : ''
%}
{%
  set event_date_ts = node.field_scheduled_date.value
%}
{%
  set event_day = event_date_ts ? event_date_ts|date('d') : ''
%}
{%
  set event_month = event_date_ts ? event_date_ts|date('M') : ''
%}
{%
  set event_time = event_date_ts ? event_date_ts|date('h:i A') : ''
%}

<a href="{{ url }}" class="event-small-card bg-white rounded-[12px] overflow-hidden cursor-pointer block shadow-soft-md group transition-all duration-300 hover:shadow-[0_12px_32px_rgba(0,0,0,0.12)] hover:-translate-y-1">
  <div class="relative h-[128px] overflow-hidden">
    {% if img_url %}
      <img src="{{ img_url }}" alt="{{ node.label() }}" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300">
    {% else %}
      <div class="absolute inset-0 bg-gradient-to-br from-blue-100 to-blue-200 w-full h-full"></div>
    {% endif %}

    <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>

    <span class="absolute top-2 left-2 bg-[#eff6ff] text-[#155dfc] font-work text-[11px] font-medium px-2.5 py-1 rounded-full">Event</span>

    {% if event_day %}
      <div class="absolute top-2 right-2 bg-black/40 backdrop-blur rounded-[8px] px-2 py-1 text-center">
        <p class="font-inter font-bold text-[14px] text-white leading-none">{{ event_day }}</p>
        <p class="font-work text-[9px] text-white/80 leading-none mt-0.5 uppercase">{{ event_month }}</p>
      </div>
    {% endif %}

    <div class="absolute bottom-2 left-2.5 right-2.5">
      <p class="font-work font-semibold text-[13px] text-white leading-tight drop-shadow truncate">{{ node.label() }}</p>
    </div>
  </div>

  <div class="p-3">
    {% if node.field_description.value %}
      {% set event_desc = '' %}
      {% if node.field_description.value is defined %}
        {% set event_desc = node.field_description.value %}
      {% elseif node.field_description.0.value is defined %}
        {% set event_desc = node.field_description.0.value %}
      {% endif %}
      {% if event_desc is iterable %}
        {% set event_desc = event_desc.value|default(event_desc[0].value|default('')) %}
      {% endif %}
      <p class="font-work text-[12px] text-[#6a7282] leading-[1.5] mb-2 line-clamp-2">{{ event_desc|default('')|striptags }}</p>
    {% else %}
      <p class="font-work text-[12px] text-[#6a7282] leading-[1.5] mb-2">Join us for this amazing event!</p>
    {% endif %}

    <div class="flex items-center gap-3 mb-2">
      {% if event_time %}
        <div class="flex items-center gap-1">
          <i data-lucide="clock" class="w-3 h-3 text-[#99a1af] shrink-0" aria-hidden="true"></i>
          <span class="font-work text-[11px] text-[#99a1af]">{{ event_time }}</span>
        </div>
      {% endif %}
      {% if node.field_host_organizer.entity %}
        <div class="flex items-center gap-1">
          <i data-lucide="map-pin" class="w-3 h-3 text-[#99a1af] shrink-0" aria-hidden="true"></i>
          <span class="font-work text-[11px] text-[#99a1af] truncate max-w-[90px]">{{ node.field_host_organizer.entity.label() }}</span>
        </div>
      {% endif %}
    </div>

    <div class="flex items-center justify-between mt-3 pt-2.5 border-t border-[#f3f4f6]">
      <span class="font-work font-bold text-[13px] text-[#155dfc]">Free</span>
      <span class="text-[#364153] font-work font-medium text-[12px] flex items-center gap-1 group-hover:text-[#155dfc] transition-colors">
        View <i data-lucide="arrow-right" class="w-3 h-3" aria-hidden="true"></i>
      </span>
    </div>
  </div>
</a>
