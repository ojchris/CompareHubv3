{#
  promo-banners.html.twig
  Promotional banner pair — desktop only.
  These are currently hardcoded. When the site owner wants to manage them,
  replace with drupal_block() calls pointing to two "Promo Banner" custom blocks.
#}
<section class="hidden sm:grid grid-cols-1 lg:grid-cols-2 gap-[29px]">

  {# ── Banner 1 — Electronics ── #}
  <div class="relative h-[220px] rounded-[16px] overflow-hidden">
    <img src="/{{ directory }}/images/electronics-banner.jpg"
         alt="Electronics deals"
         class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,_rgba(15,40,130,0.92)_0%,_rgba(21,93,252,0.72)_55%,_rgba(0,0,0,0)_100%)]"></div>
    <div class="absolute left-10 flex flex-col gap-4 top-[33.77px]">
      <div class="inline-flex items-center bg-[rgba(99,179,254,0.18)] border border-[rgba(99,179,254,0.35)] rounded-full px-3 py-1 self-start">
        <span class="font-inter font-semibold text-[11px] text-[#bedbff] tracking-[0.06px]">★ Top Tech Deals</span>
      </div>
      <div>
        <p class="font-inter font-bold text-[24px] text-white leading-[30px] tracking-[0.07px]">Phones, Laptops</p>
        <p class="font-inter font-bold text-[24px] text-white leading-[30px] tracking-[0.07px]">at Lowest Prices</p>
      </div>
      <a href="/category/electronics"
         class="bg-white text-[#1447e6] font-inter font-semibold text-[13px] tracking-[-0.08px] px-4 h-[38px] rounded-[12px] inline-flex items-center justify-center self-start hover:bg-blue-50 transition-colors">
        Shop Electronics
      </a>
    </div>
  </div>

  {# ── Banner 2 — Fresh Food ── #}
  <div class="relative h-[220px] rounded-[16px] overflow-hidden">
    <img src="/{{ directory }}/images/fresh-food-banner.jpg"
         alt="Fresh food"
         class="absolute inset-0 w-full h-full object-cover">
    <div class="absolute inset-0 bg-[linear-gradient(90deg,_rgba(13,84,43,0.88)_0%,_rgba(1,102,48,0.65)_55%,_rgba(0,0,0,0)_100%)]"></div>
    <div class="absolute left-10 flex flex-col gap-4 top-[33.88px]">
      <div class="inline-flex items-center bg-[rgba(5,223,114,0.2)] border border-[rgba(5,223,114,0.4)] rounded-full px-3 py-1 self-start">
        <span class="font-inter font-semibold text-[11px] text-[#b9f8cf] tracking-[0.06px]">🛒 Fresh Naija Groceries</span>
      </div>
      <div>
        <p class="font-work font-bold text-[24px] text-white leading-[30px] tracking-[0.07px] max-w-[244px]">Rice, Yam, Catfish at Market Prices</p>
      </div>
      <a href="/category/food"
         class="bg-white text-[#016630] font-inter font-semibold text-[13px] tracking-[-0.08px] px-4 h-[38px] rounded-[12px] inline-flex items-center justify-center self-start hover:bg-green-50 transition-colors">
        Shop Fresh Food
      </a>
    </div>
  </div>

</section>
