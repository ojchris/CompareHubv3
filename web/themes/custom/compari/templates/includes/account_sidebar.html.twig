{# 
  account_sidebar.html.twig 
  Reusable sidebar for the user portal (Dashboard, Wishlist, Compare History, etc.)
  Expects variable: active_page (e.g. 'overview', 'wishlist', 'compare_history')
#}

{# ── MOBILE: Horizontal scrollable tab bar ── #}
<div class="lg:hidden w-full mb-6">
  {# Mini user card #}
  <div class="flex items-center gap-3 mb-4 px-1">
    <div class="w-9 h-9 rounded-full bg-[#155dfc] flex items-center justify-center shrink-0">
      <span class="font-work font-bold text-[13px] text-white">{% if logged_in %}{{ user.displayname|first|upper }}{% else %}?{% endif %}</span>
    </div>
    <div class="min-w-0">
      <p class="font-work font-semibold text-[13px] text-[#101828] truncate">{% if logged_in %}{{ user.displayname }}{% else %}Guest User{% endif %}</p>
      <p class="font-work text-[11px] text-[#99a1af] truncate">{% if logged_in %}{{ user.mail.value }}{% else %}Sign in to manage your account{% endif %}</p>
    </div>
  </div>

  {# Scrollable tab bar #}
  <div class="overflow-x-auto -mx-4 px-4">
    <div class="flex gap-2 min-w-max pb-1">
      <a href="/account" class="flex items-center gap-1.5 px-3.5 py-2 rounded-full font-work font-medium text-[13px] whitespace-nowrap transition-colors {{ active_page == 'overview' ? 'bg-[#155dfc] text-white' : 'bg-white border border-[#e5e7eb] text-[#364153]' }}">
        <i data-lucide="layout-dashboard" class="w-3.5 h-3.5 shrink-0"></i> Overview
      </a>
      <a href="/wishlist" class="flex items-center gap-1.5 px-3.5 py-2 rounded-full font-work font-medium text-[13px] whitespace-nowrap transition-colors {{ active_page == 'wishlist' ? 'bg-[#155dfc] text-white' : 'bg-white border border-[#e5e7eb] text-[#364153]' }}">
        <i data-lucide="heart" class="w-3.5 h-3.5 shrink-0"></i> Wishlist
      </a>
      <a href="/compare-history" class="flex items-center gap-1.5 px-3.5 py-2 rounded-full font-work font-medium text-[13px] whitespace-nowrap transition-colors {{ active_page == 'compare_history' ? 'bg-[#155dfc] text-white' : 'bg-white border border-[#e5e7eb] text-[#364153]' }}">
        <i data-lucide="history" class="w-3.5 h-3.5 shrink-0"></i> Compare History
      </a>
      <a href="/user/edit" class="flex items-center gap-1.5 px-3.5 py-2 rounded-full font-work font-medium text-[13px] whitespace-nowrap transition-colors {{ active_page == 'security' ? 'bg-[#155dfc] text-white' : 'bg-white border border-[#e5e7eb] text-[#364153]' }}">
        <i data-lucide="shield" class="w-3.5 h-3.5 shrink-0"></i> Security
      </a>
      <a href="/user/logout" class="flex items-center gap-1.5 px-3.5 py-2 rounded-full font-work font-medium text-[13px] whitespace-nowrap bg-white border border-[#e5e7eb] text-[#fb2c36] transition-colors">
        <i data-lucide="log-out" class="w-3.5 h-3.5 shrink-0"></i> Sign Out
      </a>
    </div>
  </div>
</div>

{# ── DESKTOP: Full vertical sidebar ── #}
<aside class="hidden lg:block w-[280px] shrink-0">
  <div class="sticky top-24">
    <div class="bg-white rounded-[16px] border border-[#f3f4f6] shadow-sm overflow-hidden mb-6">
      <div class="h-24 bg-gradient-to-r from-[#155dfc] to-[#0d3ea6]"></div>
      <div class="px-6 pb-6 relative">
        <div class="w-16 h-16 rounded-full bg-white p-1 absolute -top-8 left-6">
          <div class="w-full h-full bg-[#155dfc] rounded-full flex items-center justify-center">
            <span class="font-work font-bold text-[16px] text-white">{% if logged_in %}{{ user.displayname|first|upper }}{% else %}?{% endif %}</span>
          </div>
        </div>
        <div class="mt-10">
          <p class="font-work font-semibold text-[14px] text-[#101828]">{% if logged_in %}{{ user.displayname }}{% else %}Guest User{% endif %}</p>
          <p class="font-work text-[12px] text-[#99a1af]">{% if logged_in %}{{ user.mail.value }}{% else %}Sign in to manage your account{% endif %}</p>
        </div>
      </div>
    </div>

    <nav class="space-y-1.5">
      <a href="/account" class="flex items-center gap-2.5 px-3 py-2 rounded-[10px] transition-colors {{ active_page == 'overview' ? 'bg-[#eff6ff] text-[#155dfc]' : 'text-[#364153] hover:bg-[#f3f4f6]' }}">
        <i data-lucide="layout-dashboard" class="w-4 h-4 shrink-0 {{ active_page == 'overview' ? 'text-[#155dfc]' : '' }}"></i>
        <span class="font-work font-medium text-[13px] flex-1 whitespace-nowrap">Overview</span>
      </a>
      
      <a href="/wishlist" class="flex items-center gap-2.5 px-3 py-2 rounded-[10px] transition-colors {{ active_page == 'wishlist' ? 'bg-[#eff6ff] text-[#155dfc]' : 'text-[#364153] hover:bg-[#f3f4f6]' }}">
        <i data-lucide="heart" class="w-4 h-4 shrink-0 {{ active_page == 'wishlist' ? 'text-[#155dfc]' : '' }}"></i>
        <span class="font-work font-medium text-[13px] flex-1 whitespace-nowrap">Wishlist</span>
      </a>
      
      <a href="/compare-history" class="flex items-center gap-2.5 px-3 py-2 rounded-[10px] transition-colors {{ active_page == 'compare_history' ? 'bg-[#eff6ff] text-[#155dfc]' : 'text-[#364153] hover:bg-[#f3f4f6]' }}">
        <i data-lucide="history" class="w-4 h-4 shrink-0 {{ active_page == 'compare_history' ? 'text-[#155dfc]' : '' }}"></i>
        <span class="font-work font-medium text-[13px] flex-1 whitespace-nowrap">Compare History</span>
      </a>
      
      <a href="/user/edit" class="flex items-center gap-2.5 px-3 py-2 rounded-[10px] transition-colors {{ active_page == 'security' ? 'bg-[#eff6ff] text-[#155dfc]' : 'text-[#364153] hover:bg-[#f3f4f6]' }}">
        <i data-lucide="shield" class="w-4 h-4 shrink-0 {{ active_page == 'security' ? 'text-[#155dfc]' : '' }}"></i>
        <span class="font-work font-medium text-[13px] flex-1 whitespace-nowrap">Security</span>
      </a>
      
      <a href="/user/logout" class="flex items-center gap-2.5 px-3 py-2 mt-4 rounded-[10px] text-[#fb2c36] hover:bg-[#fff1f2] transition-colors">
        <i data-lucide="log-out" class="w-4 h-4 shrink-0"></i>
        <span class="font-work font-medium text-[13px] flex-1 whitespace-nowrap">Sign Out</span>
      </a>
    </nav>
  </div>
</aside>
