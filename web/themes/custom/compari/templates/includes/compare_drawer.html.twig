<div id="compare-drawer-backdrop" aria-hidden="true"></div>
<div id="compare-drawer" role="dialog" aria-modal="true" aria-labelledby="compare-drawer-title">
  <div class="compare-drawer-header">
    <div>
      <p class="compare-drawer-kicker">Comparison list</p>
      <h2 id="compare-drawer-title">Compare products</h2>
    </div>
    <div class="compare-drawer-actions">
      <button type="button" id="compare-clear-btn" class="compare-drawer-clear">Clear all</button>
      <button type="button" id="compare-now-btn" class="compare-drawer-action">Compare now</button>
      <button type="button" id="close-compare-drawer" class="compare-drawer-close" aria-label="Close compare list">
        <i data-lucide="x" aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div id="compare-items-row" class="compare-items-row"></div>
</div>
