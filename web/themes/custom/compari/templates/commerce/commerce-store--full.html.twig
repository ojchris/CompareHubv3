{#
/**
 * @file
 * commerce-store--full.html.twig
 *
 * Full-page view of a commerce_store entity — styled to look like the
 * brand/store listing page from the CompareHub Tailwind template.
 *
 * Available variables:
 *  - commerce_store: The store entity object.
 *  - attributes: HTML attributes for the outer wrapper.
 *  - content: Rendered store fields.
 */
#}

{%
  set store_name = commerce_store.label()
%}
{%
  set store_id = commerce_store.id()
%}

{# Try to get the store logo from field_images or field_logo #}
{%
  set logo_uri = commerce_store.field_images is defined and commerce_store.field_images.entity
    ? commerce_store.field_images.entity.uri.value
    : (commerce_store.field_logo is defined and commerce_store.field_logo.entity
      ? commerce_store.field_logo.entity.uri.value
      : null)
%}
{%
  set logo_url = logo_uri ? file_url(logo_uri) : ''
%}

{# Store description #}
{%
  set store_desc = commerce_store.field_description is defined
    ? commerce_store.field_description.value|striptags
    : ''
%}

{# ── Hero / Store Header ─────────────────────────────────────────────────── #}
<section class="bg-[#f8f9fb] border-b border-[#e4e7ec] py-8">
  <div class="max-w-[1290px] mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5">

      {# Store logo avatar #}
      <div class="w-[80px] h-[80px] rounded-[16px] overflow-hidden bg-white border border-[#e4e7ec] shrink-0 flex items-center justify-center">
        {% if logo_url %}
          <img src="{{ logo_url }}" alt="{{ store_name }}" class="w-full h-full object-contain p-2">
        {% else %}
          <span class="font-work font-bold text-[28px] text-[#155dfc]">{{ store_name|first|upper }}</span>
        {% endif %}
      </div>

      {# Store info #}
      <div class="flex-1 min-w-0">
        <h1 class="font-work font-bold text-[24px] sm:text-[28px] text-[#101828] leading-tight">{{ store_name }}</h1>
        {% if store_desc %}
          <p class="font-work text-[14px] text-[#6a7282] mt-1 leading-relaxed max-w-[600px]">{{ store_desc }}</p>
        {% endif %}
      </div>

    </div>
  </div>
</section>

{# ── Products Grid ────────────────────────────────────────────────────────── #}
<section class="max-w-[1290px] mx-auto px-4 sm:px-6 py-8">
  <div class="flex items-center justify-between mb-6">
    <h2 class="font-work font-semibold text-[18px] text-[#181d25]">
      Products
      {% if store_product_count is defined and store_product_count > 0 %}
        <span class="font-work font-normal text-[14px] text-[#6a7282] ml-2">({{ store_product_count }})</span>
      {% endif %}
    </h2>
  </div>

  {% if store_products %}
    <div class="store-products-grid">
      {{ store_products }}
    </div>
  {% else %}
    <div class="text-center py-16 bg-[#f9fafb] rounded-[16px]">
      <p class="font-work text-[15px] text-[#6a7282]">No products found for this store.</p>
    </div>
  {% endif %}
</section>
