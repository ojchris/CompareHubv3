{#
  views-view-unformatted--discover.html.twig
  Grid wrapper for the /discover search results page.
#}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">

  {% if rows|length == 0 %}
    <div class="py-20 text-center">
      <div class="w-16 h-16 bg-[#f3f4f6] rounded-full flex items-center justify-center mx-auto mb-4">
        <i data-lucide="search-x" class="w-8 h-8 text-[#9ca3af]"></i>
      </div>
      <p class="font-work font-semibold text-[16px] text-[#101828]">No products found</p>
      <p class="font-work text-[13px] text-[#6b7280] mt-1">Try adjusting your search or filters.</p>
      <a href="/discover" class="inline-flex items-center gap-2 px-4 py-2 mt-6 rounded-[10px] bg-[#155dfc] text-white font-work text-[13px] font-semibold hover:bg-[#1447e6]">
        Clear filters
      </a>
    </div>
  {% else %}
    {# Scroll anchor — JS will bring the user here on page load #}
    <div id="discover-results" class="flex items-center justify-between gap-4 mb-6 px-4 py-3 bg-[#f8faff] border border-[#e0eaff] rounded-[12px]">
      <div class="flex items-center gap-2">
        <i data-lucide="layout-grid" class="w-5 h-5 text-[#155dfc] shrink-0"></i>
        <span class="font-work font-bold text-[17px] text-[#181d25]">
          {{ rows|length }} product{{ rows|length != 1 ? 's' : '' }} found
        </span>
      </div>
      <a href="/discover" class="font-work text-[13px] text-[#808793] hover:text-[#155dfc] transition-colors whitespace-nowrap">
        Clear all
      </a>
    </div>

    <div class="flex flex-wrap gap-4 items-start justify-start">
      {% for row in rows %}
        <div class="w-[calc(50%-0.5rem)] md:w-[calc(33.333%-0.75rem)] lg:w-[calc(20%-0.85rem)] shrink-0 relative">
          {{ row.content }}
        </div>
      {% endfor %}
    </div>
  {% endif %}

</div>
