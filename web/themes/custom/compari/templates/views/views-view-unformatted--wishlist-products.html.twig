{#
  views-view-unformatted--wishlist-products.html.twig
  Sidebar + grid layout for the /wishlist page.
  Active nav item: Wishlist.
#}
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-10">

    {# ── Sidebar ── #}
    {% include directory ~ '/templates/includes/account_sidebar.html.twig' with {'active_page': 'wishlist'} %}

    {# ── Main Content ── #}
    <div class="flex-1 min-w-0">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <h1 class="font-work font-bold text-[22px] sm:text-[26px] text-[#101828]">My Wishlist</h1>
          <p class="font-work text-[13px] text-[#99a1af] mt-0.5">
            {{ rows|length }} saved item{{ rows|length != 1 ? 's' : '' }} — prices update in real time
          </p>
        </div>
        <a href="/discover" class="shrink-0 flex items-center gap-2 bg-[#155dfc] text-white font-work font-semibold text-[13px] px-4 py-2.5 rounded-[12px] hover:bg-[#1447e6] transition-colors" style="text-decoration:none">
          <i data-lucide="search" class="w-4 h-4" aria-hidden="true"></i>
          Browse Products
        </a>
      </div>

      {% if rows|length == 0 %}
        <div class="py-20 text-center">
          <div class="w-16 h-16 bg-[#fff1f2] rounded-full flex items-center justify-center mx-auto mb-4">
            <i data-lucide="heart" class="w-8 h-8 text-[#fb2c36]"></i>
          </div>
          <p class="font-work font-semibold text-[16px] text-[#101828]">Your wishlist is empty</p>
          <p class="font-work text-[13px] text-[#6b7280] mt-1">Save products while browsing and they'll appear here.</p>
          <a href="/discover" class="inline-flex items-center gap-2 px-4 py-2 mt-6 rounded-[10px] bg-[#155dfc] text-white font-work text-[13px] font-semibold hover:bg-[#1447e6]" style="text-decoration:none">
            Browse Products
          </a>
        </div>
      {% else %}
        <div id="wishlist-grid" class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4">
          {% for row in rows %}
            {{ row.content }}
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</main>
