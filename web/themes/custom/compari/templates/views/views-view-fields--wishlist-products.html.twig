{#
  views-view-fields--wishlist-products.html.twig
  Single product card for the /wishlist page.
  All items here are already saved — the heart button removes them.
#}
{% set product = row._entity %}
{% set id = product.id() %}
{% set title = fields.title.content|striptags|trim %}
{% set image_content = fields.field_product_image is defined ? fields.field_product_image.content : (fields.field_image is defined ? fields.field_image.content : '') %}
{% set has_image = image_content|striptags|trim is not empty %}
{% set category = fields.field_category is defined ? fields.field_category.content|striptags|trim : '' %}

<div class="wishlist-item bg-white rounded-[16px] border border-[#f3f4f6] overflow-hidden shadow-sm hover:shadow-md transition-shadow group relative"
  data-id="{{ id }}"
  data-title="{{ title|lower|escape('html_attr') }}">

  {# Image #}
  <a href="/product/{{ id }}" class="block h-[150px] bg-[#f9fafb] relative overflow-hidden" style="text-decoration:none">
    {% set image_field = fields.field_image is defined ? fields.field_image : (fields.field_product_image is defined ? fields.field_product_image : null) %}
    {% set image_content = '' %}
    {% if image_field is not null and image_field.content is defined %}
      {% set image_content = image_field.content is iterable ? image_field.content|render|trim : image_field.content %}
    {% endif %}

    {% if image_content is not empty %}
      <div class="w-full h-full [&_img]:w-full [&_img]:h-full [&_img]:object-cover">
        {{ image_field.content }}
      </div>
    {% else %}
      <div class="w-full h-full flex items-center justify-center">
        <i data-lucide="image" class="w-10 h-10 text-[#d1d5db]"></i>
      </div>
    {% endif %}

    <div class="wishlist-badge" title="Remove from wishlist">
      {{ flag_link }}
    </div>
  </a>

  {# Body #}
  <div class="p-4">
    {% if category %}
      <p class="font-inter text-[11px] font-semibold tracking-[0.5px] text-[#99a1af] uppercase mb-1">{{ category }}</p>
    {% endif %}

    <a href="/product/{{ id }}" class="block" style="text-decoration:none">
      <p class="font-work font-bold text-[14px] text-[#101828] leading-tight group-hover:text-[#155dfc] transition-colors mb-2 line-clamp-2">{{ title }}</p>
    </a>

    {% if brand_name %}
      <a href="{{ brand_url }}" class="font-work text-[11px] text-[#808793] hover:text-[#155dfc] transition-colors" style="text-decoration:none" onclick="event.stopPropagation()">{{ brand_name }}</a>
    {% endif %}

    <div class="mt-3">
      <p class="font-inter text-[10px] text-[#808793] mb-0.5">Best price</p>
      <p class="font-inter font-bold text-[15px] text-[#155dfc]">{{ cheapest_price }}</p>
      
      <div class="mt-3">
        <button type="button" class="compare-btn w-full px-4 py-2 bg-[#f3f4f6] text-[#364153] text-[13px] font-semibold rounded-[8px] hover:bg-[#155dfc] hover:text-white transition-colors text-center" data-id="{{ id }}">+ Compare</button>
      </div>
    </div>
  </div>
</div>
