{# views-view-fields--compare-history.html.twig #}
{% set session = row._entity %}

<div class="bg-white rounded-[16px] border border-[#f3f4f6] p-5 shadow-sm flex flex-col h-full">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <i data-lucide="clock" class="w-4 h-4 text-[#99a1af]"></i>
      <span class="font-inter text-[12px] text-[#6a7282]">{{ session.created.value|date('M j, Y - g:i a') }}</span>
    </div>
  </div>

  <div class="space-y-3 mb-5 flex-1">
    {% set ids_array = [] %}
    {% for product_id, product_data in product_images %}
      {% set ids_array = ids_array|merge([product_id]) %}
      <div class="flex items-center gap-3">
        <div class="w-16 h-16 rounded-[10px] bg-[#f9fafb] border border-[#f3f4f6] overflow-hidden shrink-0 flex items-center justify-center p-1.5">
          {% if product_data.image_url %}
            <img src="{{ product_data.image_url }}" alt="{{ product_data.label }}" class="w-full h-full object-contain">
          {% else %}
            <i data-lucide="image" class="w-6 h-6 text-[#d1d5dc]"></i>
          {% endif %}
        </div>
        <p class="font-work font-medium text-[13px] text-[#364153] line-clamp-2 leading-snug">{{ product_data.label }}</p>
      </div>
    {% endfor %}
  </div>

  <button type="button" onclick="CH.compare.compareAgain('{{ ids_array|join(',') }}')" class="w-full bg-[#f9fafb] text-[#155dfc] border border-[#e5edff] font-work font-semibold text-[13px] py-2.5 rounded-[10px] hover:bg-[#155dfc] hover:text-white hover:border-[#155dfc] transition-colors flex items-center justify-center gap-2 mt-auto">
    <i data-lucide="git-compare" class="w-4 h-4"></i> Compare Again
  </button>
</div>
