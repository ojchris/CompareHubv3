{# Machine-readable row output consumed by the compare cart page. #}
{% set product_id = row._entity.getProductId()|default('') %}
{% set variation_id = row._entity.id()|default('') %}
{% set product_name = fields.title_1.content|render|striptags|trim|default(fields.title.content|render|striptags|trim) %}
{% set price = fields.price__number.content|render|striptags|trim %}
<div class="compare-listing-row"
  data-product-id="{{ product_id }}"
  data-variation-id="{{ variation_id }}"
  data-product-name="{{ product_name }}"
  data-category="{{ category }}"
  data-vendor="{{ vendor }}"
  data-store="{{ store }}"
  data-location="{{ location }}"
  data-price="{{ price }}">
  <span class="compare-listing-product-id">{{ product_id }}</span>
  <span class="compare-listing-product">{{ product_name }}</span>
  <span class="compare-listing-vendor">{{ vendor }}</span>
  <span class="compare-listing-store">{{ store }}</span>
  <span class="compare-listing-location">{{ location }}</span>
  <span class="compare-listing-price">{{ price }}</span>
</div>
