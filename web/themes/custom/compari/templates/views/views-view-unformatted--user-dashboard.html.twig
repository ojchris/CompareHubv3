{#
  views-view-unformatted--user-dashboard.html.twig
  Main layout for the /account dashboard.
#}
<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 lg:py-10">
  <div class="flex flex-col lg:flex-row gap-8 lg:gap-10">
    
    {# ── Sidebar ── #}
    {% include directory ~ '/templates/includes/account_sidebar.html.twig' with {'active_page': 'overview'} %}

    {# ── Main Content ── #}
    <div class="flex-1 min-w-0 space-y-8">
      <div>
        <h1 class="font-work font-bold text-[22px] sm:text-[26px] text-[#101828]">Welcome back, {% if logged_in %}{{ user.displayname }}{% else %}Guest{% endif %}!</h1>
        <p class="font-work text-[13px] text-[#99a1af] mt-0.5">Manage your wishlist, compare history, and account settings.</p>
      </div>

      {# Dashboard Cards #}
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a href="/wishlist" class="block p-6 bg-white rounded-[16px] border border-[#f3f4f6] shadow-sm hover:shadow-md transition-shadow group" style="text-decoration:none">
          <div class="w-12 h-12 rounded-full bg-[#eff6ff] flex items-center justify-center mb-4 group-hover:bg-[#155dfc] transition-colors">
            <i data-lucide="heart" class="w-6 h-6 text-[#155dfc] group-hover:text-white transition-colors"></i>
          </div>
          <h3 class="font-work font-semibold text-[16px] text-[#101828]">Saved Items</h3>
          <p class="font-work text-[13px] text-[#6b7280] mt-1">View your saved products and track prices.</p>
        </a>
        
        <a href="/compare-history" class="block p-6 bg-white rounded-[16px] border border-[#f3f4f6] shadow-sm hover:shadow-md transition-shadow group" style="text-decoration:none">
          <div class="w-12 h-12 rounded-full bg-[#eff6ff] flex items-center justify-center mb-4 group-hover:bg-[#155dfc] transition-colors">
            <i data-lucide="history" class="w-6 h-6 text-[#155dfc] group-hover:text-white transition-colors"></i>
          </div>
          <h3 class="font-work font-semibold text-[16px] text-[#101828]">Compare History</h3>
          <p class="font-work text-[13px] text-[#6b7280] mt-1">Pick up where you left off with your comparisons.</p>
        </a>
      </div>

      <div class="p-6 bg-white rounded-[16px] border border-[#f3f4f6] shadow-sm">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-12 h-12 rounded-full bg-[#f9fafb] flex items-center justify-center">
            <i data-lucide="shield" class="w-6 h-6 text-[#6a7282]"></i>
          </div>
          <div>
            <h3 class="font-work font-semibold text-[16px] text-[#101828]">Security Settings</h3>
            <p class="font-work text-[13px] text-[#6b7280] mt-1">Update your password and email address.</p>
          </div>
        </div>
        <a href="/user/edit" class="inline-flex items-center gap-2 px-4 py-2 mt-2 rounded-[10px] bg-[#155dfc] text-white font-work text-[13px] font-semibold hover:bg-[#1447e6]" style="text-decoration:none">
          Manage Security
        </a>
      </div>
    </div>

  </div>
</main>
