{#
  page.html.twig
  Generic page template for the Compari theme.
  Front-page-specific layout lives in page--front.html.twig.
#}

{# ── Header (mobile + desktop) ── #}
{% include directory ~ '/templates/includes/header.html.twig' %}

{# ── Top bar region (slim — breadcrumbs, page title, exposed filters, etc.) ── #}
{% if page.top_bar %}
  {{ page.top_bar }}
{% endif %}

{# ── Main content region ── #}
<main class="main-container bg-[#f9fafb] px-4 sm:px-8 lg:px-[111px] pt-[calc(65px+2rem)] sm:pt-[calc(70px+2rem)] pb-16">
  <div class="max-w-[1290px] mx-auto space-y-12">
    {% if page.highlighted %}
      {{ page.highlighted }}
    {% endif %}
    {{ page.content }}
  </div>
</main>

{# ── Footer ── #}
{% include directory ~ '/templates/includes/footer.html.twig' %}

{# ── Mobile bottom nav ── #}
{% include directory ~ '/templates/includes/mobile_nav.html.twig' %}

{# ── Auth modals ── #}
{% include directory ~ '/templates/includes/auth_modals.html.twig' %}