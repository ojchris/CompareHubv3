{#
  page.html.twig
  Page template for the Compari theme.
#}

{# ── Header (mobile + desktop) ── #}
{% include directory ~ '/templates/includes/header.html.twig' %}

{# ── Hero / Top region ── #}
{% if page.top_bar %}
  <section class="hero-region {{ is_front ? 'hero-region--full' : 'hero-region--slim' }}">
    {{ page.top_bar }}
  </section>
{% endif %}

{# ── Main content region ── #}
<main id="main-content" class="mt-[70px] sm:mt-[70px]">
  {{ page.content }}
</main>

{# ── Footer ── #}
{% include directory ~ '/templates/includes/footer.html.twig' %}

{# ── Mobile bottom nav ── #}
{% include directory ~ '/templates/includes/mobile_nav.html.twig' %}

{# ── Auth modals ── #}
{% include directory ~ '/templates/includes/auth_modals.html.twig' %}