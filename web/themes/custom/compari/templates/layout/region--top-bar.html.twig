{#
/**
 * @file
 * Default theme implementation to display a region.
 *
 * Available variables:
 * - content: The content for this region, typically blocks.
 * - attributes: HTML attributes for the region <div>.
 * - region: The name of the region variable as defined in the theme's
 *   .info.yml file.
 *
 * @see \Drupal\Core\Theme\ThemePreprocess::preprocessRegion()
 *
 * @ingroup themeable
 */
#}
{% if content %}

  <!-- ===================================================
       HERO SLIDER — visible on all screen sizes
       =================================================== -->
  <section id="hero" class="relative overflow-hidden h-[600px] sm:h-[680px]">
    <div id="slider-track">

      <!-- Slide 1 — background only -->
      <div class="slide">
        <img src="{{ directory }}/images/sliders/Slider 1.png" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true">
      </div>

      <!-- Slide 2 — background only -->
      <div class="slide">
        <img src="{{ directory }}/images/sliders/Slider 2.png" alt="" class="absolute inset-0 w-full h-full object-cover" aria-hidden="true">
      </div>

    </div><!-- /slider-track -->

    <!-- Static content overlay — does NOT slide -->
    <div class="absolute inset-0 flex flex-col items-center justify-center z-10 pt-8 sm:pt-[140px] pb-10 sm:pb-0">
      <div class="flex flex-col items-center gap-[30px] text-center w-[min(790px,100%)] px-[24px]">
        <div class="flex flex-col items-center gap-2 w-[min(563px,100%)]">
          <h1 class="font-work font-bold text-white text-center leading-tight text-[32px] sm:text-[45px] w-[min(401px,100%)]">
            Find the Best Price.Every Time.
          </h1>
          <p class="font-work font-medium text-white/90 leading-[20px] sm:leading-[28px] tracking-[-0.44px] text-[14px] sm:text-[18px] w-[min(563px,100%)] px-4 sm:px-0">
            CompareHub lets you search products and compare prices from multiple brands near you — so you always buy at the lowest price.
          </p>
        </div>

        <!-- Search bar — Drupal Views exposed form block -->
        {# This prints the Views exposed form block #}
        {{ content }}
        <!-- end Search bar -->
      </div>
    </div>

    <!-- Slider Dots -->
    <div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex items-center gap-2 z-20" aria-label="Slide indicators">
      <button class="slider-dot active" data-slide="0" aria-label="Slide 1"></button>
      <button class="slider-dot w-[6px] h-[6px] bg-[rgba(255,255,255,0.4)]" data-slide="1" aria-label="Slide 2"></button>
    </div>

  </section>


  <!-- ===================================================
       MOBILE CATEGORY PILLS — right after hero, mobile only
       =================================================== -->
   <section class="sm:hidden px-4 pt-4 pb-1">
    {{ drupal_view('browse_categories', 'block_2') }}
  </section>


  <!-- ===================================================
       MOBILE FLASH DEALS STRIP — mobile only (after categories)
       =================================================== -->
  <section class="sm:hidden px-4 pt-3">
    <div class="flash-deals-strip">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" width="21.97" height="16" style="width: 21.97px !important; height: 16px !important; min-width: 21.97px; min-height: 16px;" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <linearGradient id="flashGradient" x1="0%" y1="0%" x2="100%" y2="100%">
                <stop offset="0%" stop-color="#fcd34d" />
                <stop offset="50%" stop-color="#fb923c" />
                <stop offset="100%" stop-color="#c2410c" />
              </linearGradient>
            </defs>
            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" fill="url(#flashGradient)" stroke="url(#flashGradient)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"></polygon>
          </svg>
        </div>
        <div>
          <p class="font-work font-bold text-[14px] text-white leading-tight">Flash Deals</p>
          <p class="font-work text-[12px] leading-tight text-[rgba(255,255,255,0.75)]">Best prices, time-limited</p>
        </div>
      </div>
      <a href="/category?cat=all" class="bg-white font-work font-semibold text-[12px] text-[#155dfc] rounded-full px-4 py-2 flex items-center gap-1 shrink-0">
        Shop now
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 text-[#155dfc]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </a>
    </div>
  </section>

{% endif %}

