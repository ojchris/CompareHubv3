<?php
/**
 * @file
 * Module hooks for horizontal_event_calendar.
 */

/**
 * Implements hook_page_attachments().
 *
 * Attach our library so the JS can find the calendar placeholder and inject
 * the horizontal FullCalendar widget when the theme renders the business
 * partnership section.
 */
function horizontal_event_calendar_page_attachments(array &$attachments) {
  $attachments['#attached']['library'][] = 'horizontal_event_calendar/horizontal_event_calendar';
}
